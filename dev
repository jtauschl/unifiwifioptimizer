#!/usr/bin/env bash
# dev — repo-local convenience wrapper (bash).
#
# Commands:
#   ./dev bootstrap  No-op: no per-repo setup steps currently exist. Kept as
#                    the standard entry point for future setup needs.
#   ./dev test       Run the test suite alone (tests/*_test.sh).
#   ./dev build      No-op: this is a single Bash script with no compile
#                    step.
#   ./dev ci         Run every gate CI runs: bash -n, shellcheck, shfmt -d,
#                    actionlint (if any workflows), smoke test, tests.
#   ./dev fmt        Apply shfmt formatting in place.
#   ./dev lint       Run shellcheck alone.
#
# Handbook conformance checking no longer lives here: handbook-check.sh
# moved to this project's private docs companion repo's own scripts/
# folder and runs against this repo as an explicitly-named sibling.
# Run it from there: <companion-repo>/scripts/handbook-check.sh unifiwifioptimizer
#
# Missing tools hard-fail with install hints.
set -euo pipefail
cd "$(dirname "$0")"

SHFMT_VERSION=3.14.1

shell_scripts=(
  unifiwifioptimizer
  dev
  scripts/install.sh
  scripts/uninstall.sh
)
for f in tests/*.sh; do
  [[ -f "$f" ]] && shell_scripts+=("$f")
done

require() {
  local tool=$1 hint=$2
  if ! command -v "$tool" >/dev/null 2>&1; then
    echo "$tool not found — install: $hint" >&2
    exit 1
  fi
}

require_shfmt() {
  require shfmt "go install mvdan.cc/sh/v3/cmd/shfmt@v$SHFMT_VERSION"
  local actual_shfmt_version
  actual_shfmt_version=$(shfmt --version)
  if [[ "$actual_shfmt_version" != "$SHFMT_VERSION" ]]; then
    echo "shfmt $SHFMT_VERSION required; found $actual_shfmt_version" >&2
    exit 1
  fi
}

run_bash_syntax() {
  for f in "${shell_scripts[@]}"; do
    [[ -f "$f" ]] || continue
    bash -n "$f"
  done
}

run_shellcheck() {
  require shellcheck "brew install shellcheck (macOS) / apt-get install shellcheck (Debian)"
  local present=()
  for f in "${shell_scripts[@]}"; do
    [[ -f "$f" ]] && present+=("$f")
  done
  shellcheck -x "${present[@]}"
}

run_shfmt_diff() {
  require_shfmt
  local present=()
  for f in "${shell_scripts[@]}"; do
    [[ -f "$f" ]] && present+=("$f")
  done
  shfmt -d "${present[@]}"
}

run_shfmt_write() {
  require_shfmt
  local present=()
  for f in "${shell_scripts[@]}"; do
    [[ -f "$f" ]] && present+=("$f")
  done
  shfmt -w "${present[@]}"
}

run_actionlint() {
  if ! compgen -G ".github/workflows/*.yml" >/dev/null; then
    return 0
  fi
  require actionlint "go install github.com/rhysd/actionlint/cmd/actionlint@v1.7.12"
  actionlint
}

run_smoke() {
  ./unifiwifioptimizer --help >/dev/null
}

run_tests() {
  local f
  for f in tests/*_test.sh; do
    [[ -f "$f" ]] || continue
    bash "$f"
  done
}

run_bootstrap() {
  echo "nothing to bootstrap -- no per-repo setup steps; the shared commit-msg/pre-push hooks are a one-time, machine-wide install, not a per-repo bootstrap step"
}

run_build() {
  echo "nothing to build -- single bash script, no compile step"
}

cmd="${1:-}"
shift || true
case "$cmd" in
bootstrap)
  run_bootstrap
  ;;
test)
  run_tests
  ;;
build)
  run_build
  ;;
ci)
  run_bash_syntax
  run_shellcheck
  run_shfmt_diff
  run_actionlint
  run_smoke
  run_tests
  echo "dev ci: OK"
  ;;
fmt)
  run_shfmt_write
  ;;
lint)
  run_shellcheck
  ;;
*)
  echo "usage: ./dev {bootstrap|test|build|ci|fmt|lint}"
  exit 1
  ;;
esac
