#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"

# Single entry point for setup, lint, test and the local-first gate. `./dev ci` is what the machine-wide
# pre-push hook runs; the hosted workflow runs only the small floor plus, for pull requests from clones
# without the hook, this same gate (see .github/workflows/ci.yml).
#
# Tool-availability policy: a missing required tool fails the run. Never downgrade a check to a silent
# skip; an unchecked gate nobody notices is worse than a loud one.
#
# Two gates coexist until the Bash tool is removed: the Python package gate and the legacy shell gate
# (`legacy-bash`), both bundled into `ci`.

COMMAND=${1:-help}

UV_VERSION=0.12.24
SHFMT_VERSION=3.14.1
# SSH_ASKPASS_REQUIRE needs OpenSSH 8.4.
OPENSSH_MIN_MAJOR=8
OPENSSH_MIN_MINOR=4
# Floor of the only runtime dependency, asserted by `lower-bound`; keep in sync with pyproject.toml.
PYYAML_FLOOR=6.0
# Runtime-graph license allowlist (pip-licenses spelling). Dev-group licenses are reviewed by hand and
# documented in pyproject.toml, never gated here.
LICENSE_ALLOWLIST="MIT License;MIT;Apache Software License;Apache-2.0;BSD License;BSD-3-Clause;BSD-2-Clause"

# One EXIT trap owns every temp path this script creates; per-call-site cleanup leaks the first file
# when a second mktemp fails under set -e.
TEMP_PATHS=()
cleanup_temp_paths() {
  [ "${#TEMP_PATHS[@]}" -eq 0 ] || rm -rf "${TEMP_PATHS[@]}"
}
trap cleanup_temp_paths EXIT
# Writes into the caller's named variable instead of printing: `$(...)` would fork a subshell and the
# array append would never reach the shell the EXIT trap runs in.
new_temp_file() {
  local f
  f="$(mktemp)" || fail "mktemp failed"
  TEMP_PATHS+=("$f")
  printf -v "$1" '%s' "$f"
}
new_temp_dir() {
  local d
  d="$(mktemp -d)" || fail "mktemp -d failed"
  TEMP_PATHS+=("$d")
  printf -v "$1" '%s' "$d"
}

# ── Colors ───────────────────────────────────────────────────────────────────
BOLD=$'\e[1m'
CYAN=$'\e[1;36m'
GREEN=$'\e[1;32m'
RED=$'\e[1;31m'
RESET=$'\e[0m'

step() { printf '\n%s▶ %s%s\n' "$CYAN" "$*" "$RESET"; }
ok() { printf '%s✓ %s%s\n' "$GREEN" "$*" "$RESET"; }
fail() {
  printf '%s✗ %s%s\n' "$RED" "$*" "$RESET" >&2
  exit 1
}

# ── Toolchain checks ─────────────────────────────────────────────────────────

require_uv() {
  command -v uv &>/dev/null || fail "uv not installed (brew install uv, or https://docs.astral.sh/uv/)"
  local actual
  actual="$(uv --version | awk '{print $2}')"
  [ "$actual" = "$UV_VERSION" ] || fail "uv $UV_VERSION required (same pin as CI); found $actual"
}

require_shfmt() {
  command -v shfmt &>/dev/null || fail "shfmt not installed (go install mvdan.cc/sh/v3/cmd/shfmt@v$SHFMT_VERSION)"
  local actual
  actual="$(shfmt --version)"
  # A go-installed binary reports its module version with a leading "v"; Homebrew's does not.
  actual=${actual#v}
  [ "$actual" = "$SHFMT_VERSION" ] || fail "shfmt $SHFMT_VERSION required; found $actual"
}

require_openssh() {
  command -v ssh &>/dev/null || fail "ssh not installed"
  command -v ssh-keyscan &>/dev/null || fail "ssh-keyscan not installed"
  local banner major minor
  banner="$(ssh -V 2>&1)"
  # "OpenSSH_10.3p1, LibreSSL 3.3.6" -> 10 and 3
  major="$(printf '%s' "$banner" | sed -n 's/^OpenSSH_\([0-9]*\)\.\([0-9]*\).*/\1/p')"
  minor="$(printf '%s' "$banner" | sed -n 's/^OpenSSH_\([0-9]*\)\.\([0-9]*\).*/\2/p')"
  [ -n "$major" ] && [ -n "$minor" ] || fail "could not parse OpenSSH version from: $banner"
  if [ "$major" -lt "$OPENSSH_MIN_MAJOR" ] || { [ "$major" -eq "$OPENSSH_MIN_MAJOR" ] && [ "$minor" -lt "$OPENSSH_MIN_MINOR" ]; }; then
    fail "OpenSSH >= $OPENSSH_MIN_MAJOR.$OPENSSH_MIN_MINOR required; found $banner"
  fi
}

require_docker_daemon() {
  command -v docker &>/dev/null || fail "docker not installed (the integration harness needs it)"
  docker info --format '{{.ServerVersion}}' >/dev/null 2>&1 || fail "docker daemon not reachable — start Docker before running the integration tests"
}

# ── Setup ────────────────────────────────────────────────────────────────────

cmd_bootstrap() {
  step "bootstrap — verifying toolchain"
  require_uv
  require_openssh
  command -v shellcheck &>/dev/null || fail "shellcheck not installed (brew install shellcheck)"
  require_shfmt
  command -v actionlint &>/dev/null || fail "actionlint not installed (brew install actionlint)"
  command -v gitleaks &>/dev/null || fail "gitleaks not installed (brew install gitleaks)"
  command -v docker &>/dev/null || fail "docker not installed (the integration harness needs it)"
  step "bootstrap — uv sync (locked, all groups)"
  uv sync --locked --all-groups || fail "uv sync failed"
  ok "bootstrap — toolchain present, environment synced"
}

# ── Python gate ──────────────────────────────────────────────────────────────

cmd_ruff_check() {
  step "ruff check"
  require_uv
  uv run --locked --no-sync ruff check . || fail "ruff check: violations found"
  ok "ruff check — no violations"
}

cmd_format_check() {
  step "ruff format --check"
  require_uv
  uv run --locked --no-sync ruff format --check . || fail "ruff format: unformatted file(s) (run ./dev format)"
  ok "ruff format — correctly formatted"
}

cmd_format() {
  step "format — ruff format + ruff check --fix + shfmt -w"
  require_uv
  uv run --locked --no-sync ruff format . || fail "ruff format failed"
  uv run --locked --no-sync ruff check --fix . || fail "ruff check --fix left violations"
  local scripts=()
  collect_shell_scripts scripts
  require_shfmt
  shfmt -w "${scripts[@]}" || fail "shfmt -w failed"
  ok "format — done"
}

cmd_typecheck() {
  step "mypy --strict"
  require_uv
  uv run --locked --no-sync mypy || fail "mypy: type errors found"
  ok "mypy — no type errors"
}

cmd_bandit() {
  step "bandit"
  require_uv
  uv run --locked --no-sync bandit -q -c pyproject.toml -r src scripts || fail "bandit: findings detected"
  ok "bandit — no findings"
}

# Every fast static check for the Python side, bundled; `./dev lint` means the same thing everywhere.
cmd_lint() {
  cmd_ruff_check
  cmd_format_check
  cmd_typecheck
  cmd_bandit
}

cmd_test() {
  step "pytest — unit tests"
  require_uv
  uv run --locked --no-sync pytest || fail "pytest: unit tests failed"
  ok "pytest — unit tests passed"
}

# Each test tier records its own coverage data file; `coverage-layers` combines them. A tier that fails or
# cannot start leaves no file behind (removed before any precondition and on the failure path), so the
# combined report can never read stale data from an earlier run.
UNIT_COVERAGE_FILE=.coverage.unit
INTEGRATION_COVERAGE_FILE=.coverage.integration
COMBINED_COVERAGE_FILE=.coverage.combined
COVERAGE_FLOOR_PERCENT=85

cmd_test_integration() {
  rm -f "$INTEGRATION_COVERAGE_FILE"
  step "pytest — integration tests (Docker harness)"
  require_uv
  require_docker_daemon
  COVERAGE_FILE="$INTEGRATION_COVERAGE_FILE" uv run --locked --no-sync pytest -m integration tests/integration --cov --cov-report= || {
    rm -f "$INTEGRATION_COVERAGE_FILE"
    fail "pytest: integration tests failed"
  }
  ok "pytest — integration tests passed"
}

# The hard floor of the two-tier coverage pattern, on the unit tier only; the soft per-layer targets are
# `coverage-layers`. The floor is this command's own option, not a pyproject setting, so no other coverage
# invocation (the integration tier, the combined report) inherits it.
cmd_coverage() {
  rm -f "$UNIT_COVERAGE_FILE"
  step "pytest — unit tests with coverage gate"
  require_uv
  COVERAGE_FILE="$UNIT_COVERAGE_FILE" uv run --locked --no-sync pytest --cov --cov-report=term-missing \
    --cov-fail-under="$COVERAGE_FLOOR_PERCENT" || {
    rm -f "$UNIT_COVERAGE_FILE"
    fail "pytest: tests failed or coverage below the floor"
  }
  ok "coverage — floor met"
}

# Soft tier: unit and integration data combined, one line per layer against its target plus the files
# below it. A layer below target only prints; a missing tier fails, because that is an unmeasured tier.
cmd_coverage_layers() {
  step "coverage — per-layer soft targets over unit + integration"
  require_uv
  rm -f "$COMBINED_COVERAGE_FILE"
  uv run --locked --no-sync coverage combine --keep --data-file="$COMBINED_COVERAGE_FILE" \
    "$UNIT_COVERAGE_FILE" "$INTEGRATION_COVERAGE_FILE" ||
    fail "coverage combine failed — run ./dev coverage and ./dev test-integration first"
  uv run --locked --no-sync python -m tests.tools.coverage_layers --data-file "$COMBINED_COVERAGE_FILE" ||
    fail "coverage-layers: a tier is unmeasured"
  ok "coverage-layers — reported"
}

# Resolves the direct runtime dependency at its declared floor on a throwaway copy, so the committed
# uv.lock stays untouched: the resolution mode is written into the lock. UV_RESOLUTION is exported for
# every uv call in the copy, since a later call without it re-locks to the newest versions.
cmd_lower_bound() {
  step "lower-bound — resolve direct dependencies at their declared floor"
  require_uv
  local probe
  new_temp_dir probe
  cp -R src tests pyproject.toml .python-version README.md LICENSE "$probe/" || fail "could not copy the project into the probe directory"
  (
    cd "$probe" || exit 1
    export UV_RESOLUTION=lowest-direct
    # No .git in the copy, so hatch-vcs cannot derive a version.
    export SETUPTOOLS_SCM_PRETEND_VERSION=0.0.0
    uv lock || exit 1
    uv sync --locked --all-groups || exit 1
    actual="$(uv run --locked --no-sync python -c 'import yaml; print(yaml.__version__)')" || exit 1
    if [ "$actual" != "$PYYAML_FLOOR" ]; then
      echo "lower-bound: pyyaml resolved to $actual, expected the declared floor $PYYAML_FLOOR" >&2
      exit 1
    fi
    uv run --locked --no-sync pytest -q || exit 1
  ) || fail "lower-bound: resolution at the floor failed or the floor is not what pyproject.toml declares"
  ok "lower-bound — unit tests pass with pyyaml==$PYYAML_FLOOR"
}

cmd_lock_check() {
  step "lock-check — uv.lock up to date"
  require_uv
  uv lock --check || fail "uv.lock is stale (run uv lock)"
  step "lock-check — build-constraints.txt matches build-constraints.in and pyproject.toml"
  uv run --locked --no-sync python scripts/check_build_constraints.py pyproject.toml build-constraints.in ||
    fail "build-constraints.in does not match [build-system].requires"
  local recompiled
  new_temp_file recompiled
  uv pip compile build-constraints.in --generate-hashes --universal --python-version 3.11 --no-header --quiet -o "$recompiled" ||
    fail "could not recompile build-constraints.in"
  diff -u build-constraints.txt "$recompiled" || fail "build-constraints.txt is stale (recompile with ./dev lock-refresh)"
  ok "lock-check — lockfile and build constraints are current"
}

cmd_lock_refresh() {
  step "lock-refresh — recompile the hashed build constraints"
  require_uv
  # Without --upgrade, uv keeps the pins already in the output file, so a refresh would never move.
  uv pip compile build-constraints.in --upgrade --generate-hashes --universal --python-version 3.11 --no-header -o build-constraints.txt ||
    fail "could not recompile build-constraints.in"
  ok "lock-refresh — build-constraints.txt rewritten"
}

# Only the shipped graph is gated: `uv export --no-dev` lists exactly what an installation resolves.
cmd_licenses() {
  step "licenses — runtime dependency graph against the allowlist"
  require_uv
  local exported
  new_temp_file exported
  uv export --locked --no-dev --no-hashes --no-emit-project --no-header --format requirements.txt --quiet -o "$exported" ||
    fail "uv export failed"
  local packages=()
  local line
  while IFS= read -r line; do
    case "$line" in
    "" | "#"* | " "*) ;;
    *) packages+=("${line%%==*}") ;;
    esac
  done <"$exported"
  [ "${#packages[@]}" -gt 0 ] || fail "licenses: the runtime graph is empty, which cannot be right"
  uv run --locked --no-sync pip-licenses --packages "${packages[@]}" --allow-only "$LICENSE_ALLOWLIST" --format=markdown ||
    fail "licenses: a runtime dependency is outside the allowlist"
  ok "licenses — ${#packages[@]} runtime package(s) within the allowlist"
}

# The build runs with the hashed build-backend closure, the same way the release workflow builds.
cmd_build() {
  step "build — sdist + wheel with hashed build constraints"
  require_uv
  rm -rf dist || fail "could not remove dist/"
  uv build --build-constraints build-constraints.txt --require-hashes || fail "uv build failed"
  ok "build — artifacts in dist/"
  cmd_smoke
}

cmd_smoke() {
  step "smoke — install the wheel into a throwaway environment and run it"
  require_uv
  local venv wheel
  new_temp_dir venv
  wheel="$(ls dist/*.whl)" || fail "no wheel in dist/ (run ./dev build)"
  uv venv --quiet "$venv/venv" || fail "could not create the smoke venv"
  uv pip install --quiet --python "$venv/venv/bin/python" "$wheel" || fail "could not install the wheel"
  "$venv/venv/bin/unifiwifioptimizer" --version || fail "installed entry point failed"
  "$venv/venv/bin/python" -m unifiwifioptimizer --help >/dev/null || fail "python -m unifiwifioptimizer failed"
  # The shipped profiles are package data; printing them from the installed wheel proves they were packaged.
  # The developer's own configuration, data and home trees stay out of it (a legacy install would otherwise
  # be found), and a refusal must be the configuration exit code, not a crash.
  local rc=0
  env HOME="$venv" XDG_CONFIG_HOME="$venv" XDG_DATA_HOME="$venv" "$venv/venv/bin/unifiwifioptimizer" --profiles-file /dev/null config --profiles >/dev/null 2>&1 || rc=$?
  [ "$rc" -eq 3 ] || fail "config --profiles with /dev/null exited $rc, expected 3"
  env HOME="$venv" XDG_CONFIG_HOME="$venv" XDG_DATA_HOME="$venv" "$venv/venv/bin/unifiwifioptimizer" config --profiles | grep '^profiles:' >/dev/null || fail "config --profiles did not print the shipped profiles"
  ok "smoke — wheel installs and runs"
}

# ── Shell gate ───────────────────────────────────────────────────────────────

# `dev` is always included so the wrapper's own shell code is checked. Everything else is discovered,
# not hand-listed; a fixed list silently excludes whatever a later change adds. The legacy Bash tool and
# its tests are part of the set until they are removed.
collect_shell_scripts() {
  local -a found=(dev)
  local f
  [ -f unifiwifioptimizer ] && found+=(unifiwifioptimizer)
  # find's exit status does not survive a `while … < <(find …)` process substitution, so discovery goes
  # through a temp file whose write can be checked.
  local listing listing_error
  new_temp_file listing
  new_temp_file listing_error
  # The remote scan script is a package resource, piped to the access point's `sh -s`; it carries a
  # `shellcheck shell=sh` directive instead of a shebang.
  if ! find scripts tests src/unifiwifioptimizer/adapters/ssh -maxdepth 1 -name '*.sh' 2>"$listing_error" | sort >"$listing"; then
    fail "find scripts/*.sh tests/*.sh src/…/adapters/ssh/*.sh discovery failed: $(cat "$listing_error")"
  fi
  while IFS= read -r f; do
    found+=("$f")
  done <"$listing"
  # The harness stubs are shell scripts without an extension (they stand in for `iw` and `ifconfig`).
  for f in docker/ap/entrypoint.sh docker/ap/stubs/iw docker/ap/stubs/ifconfig; do
    [ -f "$f" ] && found+=("$f")
  done
  eval "$1=(\"\${found[@]}\")"
}

cmd_shellcheck() {
  local shell_scripts=()
  collect_shell_scripts shell_scripts

  step "shellcheck — ${#shell_scripts[@]} shell script(s)"
  command -v shellcheck &>/dev/null || fail "shellcheck not installed (brew install shellcheck)"
  shellcheck -x "${shell_scripts[@]}" || fail "shellcheck: violations found"
  ok "shellcheck — no violations"

  step "shfmt — formatting"
  require_shfmt
  # shfmt -l exits 1 both for "unformatted files" (stdout lists them) and for a tool error (stdout
  # empty, stderr set); only the combination tells them apart.
  local shfmt_stderr
  new_temp_file shfmt_stderr
  set +e
  local unformatted
  unformatted=$(shfmt -l "${shell_scripts[@]}" 2>"$shfmt_stderr")
  local shfmt_status=$?
  set -e
  if ! { [ "$shfmt_status" -eq 0 ] || { [ "$shfmt_status" -eq 1 ] && [ -n "$unformatted" ]; }; }; then
    fail "shfmt: tool error (exit $shfmt_status): $(cat "$shfmt_stderr")"
  fi
  [ -z "$unformatted" ] || fail "shfmt: unformatted file(s) (run ./dev format): $unformatted"
  ok "shfmt — correctly formatted"

  step "bash -n — syntax check"
  local f
  for f in "${shell_scripts[@]}"; do
    bash -n "$f" || fail "bash -n: syntax error in $f"
  done
  ok "bash -n — no syntax errors"

  step "smoke test — ./dev help"
  ./dev help >/dev/null || fail "./dev help failed"
  ok "smoke test — passed"
}

# Legacy gate for the Bash tool; removed together with the tool.
cmd_legacy_bash() {
  step "legacy-bash — smoke test and shell test suite"
  [ -x unifiwifioptimizer ] || fail "legacy Bash tool not found"
  ./unifiwifioptimizer --help >/dev/null || fail "legacy Bash tool: --help failed"
  local f ran=0
  for f in tests/*_test.sh; do
    [ -f "$f" ] || fail "legacy Bash tests: no tests/*_test.sh found"
    bash "$f" || fail "legacy Bash tests: $f failed"
    ran=$((ran + 1))
  done
  ok "legacy-bash — $ran test file(s) passed"
}

cmd_actionlint() {
  step "actionlint — GitHub Actions workflows"
  command -v actionlint &>/dev/null || fail "actionlint not installed (brew install actionlint)"
  actionlint || fail "actionlint: violations found"
  ok "actionlint — no violations"
}

cmd_gitleaks() {
  step "gitleaks — secret scan (full history)"
  command -v gitleaks &>/dev/null || fail "gitleaks not installed (brew install gitleaks)"
  gitleaks git --log-opts="--all" --redact --exit-code 1 || fail "gitleaks: findings detected"
  ok "gitleaks — no findings"
}

# ── CI-floor commands (not part of `ci`, mirrored by the hosted workflow) ────

cmd_sast() {
  step "sast — semgrep"
  command -v semgrep &>/dev/null || fail "semgrep not installed (brew install semgrep)"
  semgrep scan --config=p/python --config=p/secrets --config=p/security-audit --error --metrics=off . || fail "semgrep: findings detected"
  ok "sast — no findings"
}

# uv leaves the root component's version out for a dynamically versioned project; it is written in
# afterwards from hatch-vcs so the SBOM says which build it describes.
cmd_sbom() {
  step "sbom — CycloneDX from the locked runtime graph"
  require_uv
  uv export --locked --no-dev --format cyclonedx1.5 --output-file sbom.cdx.json --quiet || fail "uv export failed"
  local version
  # Without --no-sync: the hosted sbom job calls this on a fresh checkout with no environment yet.
  version="$(uv run --locked python -m hatchling version)" || fail "could not determine the project version"
  uv run --locked --no-sync python scripts/sbom_set_root_version.py sbom.cdx.json "$version" || fail "could not set the SBOM root version"
  ok "sbom — sbom.cdx.json (root version $version)"
}

# Full locked graph (runtime + dev) and the hashed build backend; needs the live advisory database.
# The graph is audited from a hashed export of uv.lock rather than from the synced environment: the
# project itself is installed editable with a hatch-vcs dev version that never exists on PyPI, and
# pip-audit --strict reports that as a collection failure. pip-audit itself comes from the locked dev
# group, so `uv run --locked` without --no-sync lets the hosted job run this on a fresh checkout.
cmd_audit() {
  step "audit — pip-audit over the locked runtime + dev graph"
  require_uv
  local locked_graph
  new_temp_file locked_graph
  uv export --locked --all-groups --no-emit-project --no-header --format requirements.txt --quiet -o "$locked_graph" ||
    fail "uv export failed"
  uv run --locked pip-audit --strict --require-hashes -r "$locked_graph" ||
    fail "pip-audit: vulnerabilities in the locked graph or incomplete collection"
  step "audit — pip-audit over the build backend"
  uv run --locked --no-sync pip-audit --strict --require-hashes -r build-constraints.txt ||
    fail "pip-audit: vulnerabilities in the build backend"
  ok "audit — no known vulnerabilities"
}

# ── CI ───────────────────────────────────────────────────────────────────────

# Runs one check in a subshell so fail()'s exit ends only that subshell, and re-arms the temp-path
# cleanup inside it: a subshell starts with the EXIT trap reset, so paths registered there would
# otherwise never be removed. Records the failure in the caller's `failures`/`failed_checks`.
# errexit is inert inside a `( … ) ||` subshell, so every command in a check needs its own `|| fail`
# (or `|| exit 1`); a bare failing command would be ignored.
run_check() {
  local name=$1 check=$2
  (
    TEMP_PATHS=()
    trap cleanup_temp_paths EXIT
    "$check"
  ) || {
    # Assignment, not `((failures++))`: that form returns 1 when the old value was 0 and trips
    # set -e on bash 4.1+.
    failures=$((failures + 1))
    failed_checks+=("$name")
  }
}

# Accumulates every failing check instead of stopping at the first.
cmd_ci() {
  local failures=0
  local failed_checks=()

  run_check "shellcheck" cmd_shellcheck
  run_check "actionlint" cmd_actionlint
  run_check "gitleaks" cmd_gitleaks
  run_check "legacy-bash" cmd_legacy_bash
  run_check "lint" cmd_lint
  run_check "coverage" cmd_coverage
  run_check "test-integration" cmd_test_integration
  run_check "coverage-layers" cmd_coverage_layers
  run_check "lower-bound" cmd_lower_bound
  run_check "lock-check" cmd_lock_check
  run_check "licenses" cmd_licenses
  run_check "build" cmd_build

  if [ "$failures" -gt 0 ]; then
    fail "ci — $failures check(s) failed: ${failed_checks[*]}"
  fi
  ok "ci — all checks passed"
}

# Mechanical release preconditions only; the rest of the release checklist stays a human-run process.
cmd_release_check() {
  local branch
  branch="$(git rev-parse --abbrev-ref HEAD)" || fail "git rev-parse failed"
  [ "$branch" != "HEAD" ] || fail "in detached HEAD state — check out a real branch before releasing"

  (
    TEMP_PATHS=()
    trap cleanup_temp_paths EXIT
    cmd_ci
  ) || fail "cmd_ci failed — fix all checks before releasing"

  step "git — fetch + divergence check ($branch vs. its remote)"
  git fetch --prune origin || fail "git fetch failed"
  git rev-parse --verify --quiet "origin/$branch" >/dev/null || fail "no origin/$branch — this branch has no upstream to compare against"
  local behind ahead
  behind="$(git rev-list --count "HEAD..origin/$branch")" || fail "git rev-list (behind) failed"
  ahead="$(git rev-list --count "origin/$branch..HEAD")" || fail "git rev-list (ahead) failed"
  [ "$behind" = "0" ] || fail "$branch is $behind commit(s) behind origin/$branch — pull first"
  [ "$ahead" = "0" ] || fail "$branch is $ahead commit(s) ahead of origin/$branch — push first, a release builds from a pushed commit"

  step "git — working tree clean?"
  local porcelain
  porcelain="$(git status --porcelain)" || fail "git status failed"
  [ -z "$porcelain" ] || fail "uncommitted changes present (git status --porcelain)"

  step "git — config.yaml never tracked?"
  # ls-files exits 1 for "not tracked" (the wanted state) and with another code for a real git error.
  local tracked_status=0
  git ls-files --error-unmatch config.yaml >/dev/null 2>&1 || tracked_status=$?
  case "$tracked_status" in
  0) fail "config.yaml is tracked — it holds credentials" ;;
  1) ;;
  *) fail "git ls-files failed (exit $tracked_status)" ;;
  esac

  ok "release-check — mechanical preconditions passed (see the release checklist for the rest)"
}

cmd_help() {
  echo "${BOLD}Usage:${RESET} ./dev <command>"
  echo ""
  echo "${BOLD}Setup:${RESET}"
  printf "  %-20s %s\n" "bootstrap" "verify toolchain (uv $UV_VERSION, OpenSSH >= $OPENSSH_MIN_MAJOR.$OPENSSH_MIN_MINOR, shellcheck, shfmt $SHFMT_VERSION, actionlint, gitleaks, docker) and uv sync"
  echo ""
  echo "${BOLD}Python:${RESET}"
  printf "  %-20s %s\n" "lint" "ruff check + ruff format --check + mypy + bandit, bundled"
  printf "  %-20s %s\n" "ruff-check" "ruff check"
  printf "  %-20s %s\n" "format-check" "ruff format --check"
  printf "  %-20s %s\n" "format" "ruff format + ruff check --fix + shfmt -w (auto-fixing)"
