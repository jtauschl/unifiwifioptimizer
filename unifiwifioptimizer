# Print a hint noting how many pending TX-power recommendations are still
# open on this site. A missing sighting is often caused by TX power being
# too low to reach the neighbor, so pointing at the more fundamental fix
# first avoids chasing a symptom (e.g. an Incomplete/Not-evaluable Roaming
# Assistant verdict) whose root cause is elsewhere. Silent if the count
# file is missing or zero.
print_tx_pending_note() {
  local site=$1
  local pending
  pending=$(cat "$(tx_pending_count_path "$site")" 2>/dev/null)
  [[ -z "$pending" || "$pending" -eq 0 ]] && return
  local plural=""
  ((pending != 1)) && plural="s"
  printf "  ${YELLOW}    Note: %s access point%s on this site still have a pending TX power recommendation — apply those first, then re-run; a missing sighting is often caused by TX power being too low to reach a neighbor.${RESET}\n" \
    "$pending" "$plural"
}

# Advisory: MLO mandates WPA3 (PSK or Enterprise) + PMF Required by spec --
# OWE is not a valid substitute for MLO's client authentication requirement.
# Checked against the WLAN's actual controller configuration, not its
# matched profile -- this is a protocol-level consistency rule, not a
# profile compliance check.
#
# The 6 GHz band is NOT checked here even though it has the same WPA3/OWE +
# PMF Required requirement by spec: the WLAN-level security/PMF fields this
# tool reads are shared across all bands on a multiband SSID, and the 6 GHz
# band forbids WPA2/WPA3 transition mode -- so a 6 GHz-capable WLAN's
# WLAN-level fields legitimately show WPA2/WPA3 + PMF Optional (UniFi's own
# default when 6 GHz is enabled) while the 6 GHz radio itself enforces
# WPA3-only + PMF Required internally, with no separate per-band field this
# tool can read to confirm it. Flagging the WLAN-level fields here would be a
# false positive against UniFi's own default 6 GHz configuration.
print_wpa3_pmf_required_advisory() {
  local mlo=$1 actual_security_protocol=$2 actual_pmf=$3

  is_true "$mlo" || return 0

  if ! security_protocol_uses_wpa3 "$actual_security_protocol" || [[ "$actual_pmf" != "Required" ]]; then
    printf "  ${YELLOW}    ! %s${RESET}\n" \
      "MLO requires WPA3 + PMF Required by spec — current: ${actual_security_protocol}/${actual_pmf}."
  fi
}

# Advisory: 802.11r (Fast Transition) is only effective as a fast, seamless
# handoff when paired with 802.11v (BSS Transition Management, already
# tracked separately as bss_transition). 802.11k (Radio Resource Management)
# is not included here -- UniFi exposes no UI control for it on either the
# WLAN or the AP, live-verified 2026-08-08, so a warning about it would not
# be actionable.
# Checked against the WLAN's actual controller configuration, not its
# matched profile.
print_fast_roaming_bss_transition_advisory() {
  local fast_roaming=$1 bss_transition=$2

  is_true "$fast_roaming" || return 0
  is_true "$bss_transition" && return 0

  printf "  ${YELLOW}    ! %s${RESET}\n" \
    "802.11r Fast Transition works best paired with 802.11v (BSS Transition) — currently disabled."
}

# Advisory: 802.11r (Fast Transition) is known to break specific IoT client
# classes -- some ESP32, older printers, Sonos gen1. Heuristic for "this WLAN
# is IoT-serving": profile name is IoT OR the WLAN broadcasts only on 2.4 GHz
# and profile name is Standard-family. Silent when Fast Roaming is off or the
# profile is one of the recommendation profiles (Throughput/Latency) which
# expect it on.
print_fast_roaming_iot_advisory() {
  local profile=$1 actual_wifi_bands=$2 fast_roaming=$3
  local is_2g_only=false
  is_true "$fast_roaming" || return 0

  wifi_band_includes "$actual_wifi_bands" "2g" &&
    ! wifi_band_includes "$actual_wifi_bands" "5g" &&
    ! wifi_band_includes "$actual_wifi_bands" "6g" &&
    is_2g_only=true

  case "$profile" in
  IoT) ;;
  Standard*)
    [[ "$is_2g_only" == "true" ]] || return 0
    ;;
  *) return 0 ;;
  esac

  printf "  ${YELLOW}    ! %s${RESET}\n" \
    "802.11r Fast Transition is known to break some IoT clients (ESP32, older printers, Sonos gen1) — consider splitting IoT off to its own SSID with 802.11r disabled, or rely on BSS Transition (802.11v) alone."
}

# Roaming Assistant compliance check (ALGORITHM.md §7). Compares the WLAN's
# actual roaming_assistant_na_* value against the site-aware target computed
# by prepare_site_roaming_checks() and cached in roaming_wlan.tsv/
# roaming_detail.tsv. Band applicability is decided from actual_wifi_bands
# (the real controller config), never from the profile's expected bands --
# a WLAN that deviates from its profile on band already gets flagged by the
# separate "WiFi Band" check, so this avoids reporting the same deviation twice.
# Surfaces a "fix TX power first" hint alongside an incomplete/not_evaluable
# Roaming Assistant verdict, when this site still has pending TX power
# recommendations (see prepare_site_tx_checks()) -- a missing neighbor
# sighting is often caused by TX power being too low to reach that neighbor.
print_general_check_roaming_assistant() {
  local site=$1 wlan_name=$2 na_enabled=$3 na_rssi=$4 actual_wifi_bands=$5 expected_roaming_assistant=$6
  local label="Roaming Assistant"

  if ! wifi_band_includes "$actual_wifi_bands" "5g"; then
    printf "  %-${GENERAL_LABEL_WIDTH}s %s\n" "$label" "N/A (5 GHz not broadcast)"
    return
  fi

  local wlan_row
  wlan_row=$(awk -F "$WLAN_FIELD_SEP" -v w="$wlan_name" '$1 == w { print; exit }' "$(roaming_wlan_tsv_path "$site")")

  if [[ -z "$wlan_row" ]]; then
    printf "  %-${GENERAL_LABEL_WIDTH}s %s\n" "$label" "N/A (older API without roaming_assistant_na_*)"
    return
  fi

  # The wlan_row lookup above is unavoidable even for expected=false: it is
  # the only way to detect the "older API, field absent" N/A case, which
  # takes priority over the profile's enable/disable expectation regardless
  # of what that expectation is. Its aggregated_rssi/completeness contents
  # are simply unused below when the profile expects Roaming Assistant off.
  if ! is_true "$expected_roaming_assistant"; then
    if ! is_true "$na_enabled"; then
      printf "  ${GREEN}  ✓ %-${GENERAL_LABEL_WIDTH}s %s${RESET}\n" "$label" "Disabled (per profile)"
    else
      flag_change
      printf "  ${RED}  ✗ %-${GENERAL_LABEL_WIDTH}s %s${RESET}\n" "$label" "Enabled, but profile expects disabled"
      print_ui_path_hint "$label"
    fi
    return
  fi

  local _w aggregated_rssi completeness incomplete_reasons
  IFS="$WLAN_FIELD_SEP" read -r _w aggregated_rssi completeness incomplete_reasons <<<"$wlan_row"

  if [[ "$completeness" == "na" ]]; then
    printf "  %-${GENERAL_LABEL_WIDTH}s %s\n" "$label" "$incomplete_reasons"
    return
  fi

  if [[ "$completeness" == "not_evaluable" ]]; then
    printf "  ${YELLOW}  ? %-${GENERAL_LABEL_WIDTH}s Not evaluable: %s${RESET}\n" "$label" "$incomplete_reasons"
    print_tx_pending_note "$site"
    return
  fi

  if [[ "$completeness" == "incomplete" ]]; then
    printf "  ${YELLOW}  ? %-${GENERAL_LABEL_WIDTH}s Incomplete: %s${RESET}\n" "$label" "$incomplete_reasons"
    print_tx_pending_note "$site"
    return
  fi

  # A blank na_rssi (partial API response, migration in progress) must not
  # be coerced by bash arithmetic to 0 and then compared against the real
  # aggregated_rssi -- that would report every such WLAN as a deviation with
  # no visible reason. Treat "no value returned" as its own deviation state
  # and print blank rather than the coerced zero.
  if ! is_true "$na_enabled" || [[ -z "$na_rssi" ]] || ((na_rssi != aggregated_rssi)); then
    flag_change
    printf "  ${RED}  ✗ %-${GENERAL_LABEL_WIDTH}s Enabled, %s dBm${RESET}\n" "$label" "$aggregated_rssi"
    print_ui_path_hint "$label"
  else
    printf "  ${GREEN}  ✓ %-${GENERAL_LABEL_WIDTH}s Enabled, %s dBm${RESET}\n" "$label" "$na_rssi"
  fi

  local _w limiting_ap weakest_peer weakest_peer_rssi raw_cap warn_status
  while IFS=$'\t' read -r _w limiting_ap weakest_peer weakest_peer_rssi raw_cap warn_status; do
    [[ -z "$limiting_ap" ]] && continue
    case "$warn_status" in
    capped_by_margin)
      printf "\n  ${YELLOW}* Roaming Assistant lowered to %s dBm: weakest neighbor of %s is %s (%s dBm), below TX_LO (%d dBm).${RESET}\n" \
        "$aggregated_rssi" "$limiting_ap" "$weakest_peer" "$weakest_peer_rssi" "$TX_LO"
      printf '  %s  Coverage-limited recommendation — consider repositioning %s or adding a neighbor AP.%s\n' "$YELLOW" "$limiting_ap" "$RESET"
      ;;
    capped_by_floor)
      printf "\n  ${YELLOW}* Roaming Assistant clamped to ROAM_FLOOR (%s dBm) for %s: weakest neighbor %s (%s dBm) would yield %s dBm.${RESET}\n" \
        "$aggregated_rssi" "$limiting_ap" "$weakest_peer" "$weakest_peer_rssi" "$raw_cap"
      printf '  %s  No reachable roaming neighbor at this AP — consider repositioning %s or adding a neighbor AP.%s\n' "$YELLOW" "$limiting_ap" "$RESET"
      ;;
    esac
  done < <(awk -F '\t' -v w="$wlan_name" '$1 == w { print }' "$(roaming_detail_tsv_path "$site")")
}

# Print all WLAN-level general compliance checks for a site.
print_general_checks() {
  local site=$1
  local matched=false
  local wlan_name profile_name actual_row profile_row
  local enabled bss_transition fast_roaming
  local minrate_mode dtim_mode
