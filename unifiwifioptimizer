}

# Per-site, per-AP, per-band TX power pending-change precompute. Must run
# inside the site loop, after TX_LO/TX_HI are set for this site (shares
# calculate_tx_recommendation() with analyze_band(), which depends on
# TX_LO/TX_HI via calculate_tx_shift()). Duplicates the neighbor-RSSI
# collection from analyze_band() (unifiwifioptimizer, "Main: Analysis &
# Output" AP loop) rather than sharing it, since that collection is tightly
# coupled to the AP-loop context (scan prefixes, peer lists) that hasn't run
# yet at this point in the site iteration -- the same trade-off
# prepare_site_roaming_checks() already makes for the WLAN-level aggregation.
prepare_site_tx_checks() {
  local site=$1
  local pending=0
  local current_site ap mac_col _ip_col _model_col
  local band_key band_mac curr_tx min_tx_b max_tx_b txmode
  local radio_info radio_ch radio_cht scan_prefix scan_file
  local peers peer peer_cache rssi_to
  local sum_rssi count_nbr peer_count has_missing_partial

  : >"$(tx_pending_count_path "$site")"

  while IFS=$'\t' read -r current_site ap mac_col _ip_col _model_col; do
    [[ "$current_site" != "$site" ]] && continue

    peers="$(get_peers "$site" "$ap")"
    scan_prefix=$(ap_scan_prefix "$site" "$ap")

    for band_key in 2g 5g; do
      radio_info=$(get_radio_info "$site" "$ap")
      if [[ "$band_key" == "2g" ]]; then
        IFS='|' read -r radio_ch radio_cht curr_tx min_tx_b max_tx_b txmode _ <<<"$radio_info"
      else
        IFS='|' read -r _ _ _ _ _ _ _ _ radio_ch radio_cht curr_tx min_tx_b max_tx_b txmode _ <<<"$radio_info"
      fi

      # Skip a band the AP does not actually operate: the scan file marks
      # it with ===NO_RADIO=== (see analyze_band's own early-return, which
      # renders "band not active"), and the API returns no ch/width/tx.
      # Without this guard, the site-level pending-TX count picks up phantom
      # bands that never appear in the per-AP report.
      scan_file="${scan_prefix}.${band_key}"
      if grep -qF '===NO_RADIO===' "$scan_file" 2>/dev/null &&
        [[ -z "${radio_ch}${radio_cht}${curr_tx}" ]]; then
        continue
      fi

      # Defaults must match analyze_band's own defaults for the same fields
      # (see the AP loop near the end of the file): 11 dBm for 2.4 GHz,
      # 20 dBm for 5 GHz. Any divergence here versus there produces a
      # site-summary count that disagrees with the per-AP report.
      if [[ "$band_key" == "2g" ]]; then
        curr_tx=${curr_tx:-11}
      else
        curr_tx=${curr_tx:-20}
      fi
      min_tx_b=${min_tx_b:-$TX_MIN}
      max_tx_b=${max_tx_b:-$TX_MAX}
      txmode=${txmode:-custom}

      band_mac=$(mac_with_offset "$mac_col" "$([[ "$band_key" == "2g" ]] && echo 1 || echo 2)")

      sum_rssi=0
      count_nbr=0
      peer_count=0
      has_missing_partial=false
      for peer in $peers; do
        peer_count=$((peer_count + 1))
        peer_cache=$(scan_rssi_cache_path "$(ap_scan_prefix "$site" "$peer").${band_key}")
        rssi_to=$(get_rssi "$band_mac" "$peer_cache")
        if [[ -n "$rssi_to" ]]; then
          sum_rssi=$((sum_rssi + rssi_to))
          count_nbr=$((count_nbr + 1))
        else
          has_missing_partial=true
        fi
      done
      # A fully-missing peer set at count_nbr==0 is handled entirely inside
      # calculate_tx_recommendation()'s zero-sightings branch; the partial-nudge
      # flag only matters when count_nbr>0 (see that function's contract).
      ((count_nbr == 0)) && has_missing_partial=false

      calculate_tx_recommendation "$curr_tx" "$min_tx_b" "$max_tx_b" "$sum_rssi" "$count_nbr" \
        "$peer_count" "$has_missing_partial"

      if [[ "$txmode" != "custom" ]] || ((_result != curr_tx)); then
        pending=$((pending + 1))
      fi
    done
  done <"$APS_FILE"

  printf '%s\n' "$pending" >"$(tx_pending_count_path "$site")"
}

# Per-site, per-WLAN Roaming Assistant aggregation (ALGORITHM.md §7).
# Must run inside the site loop, after TX_LO/TX_HI are set for this site
# (calculate_roaming_recommendation() depends on the site-specific TX_LO).
#
# For each WLAN broadcasting on 5 GHz, aggregates the per-AP corridor-based
# threshold over the APs that actually broadcast that SSID, restricted to
# each AP's configured RF neighbors that also broadcast the same SSID
# (SSID_peers(AP) = RF_neighbors(AP) ∩ broadcasting_APs(WLAN)). Writes:
#   roaming_wlan.tsv:   wlan_name, aggregated_rssi, completeness, incomplete_reasons
#   roaming_detail.tsv: wlan_name, limiting_ap, weakest_peer, weakest_peer_rssi, raw_cap, warning_status
#     (one row per limiting AP; 0 rows when no cap engaged or not evaluable)
prepare_site_roaming_checks() {
  local site=$1

  : >"$(roaming_wlan_tsv_path "$site")"
  : >"$(roaming_detail_tsv_path "$site")"
  rm -f "$(roaming_field_present_flag_path "$site")"

  # API-model detection: does ANY WLAN on this site (per the full API
  # response, not config.yaml's mapping) expose roaming_assistant_na_*?
  # Deliberately a separate, unconditional first pass over
  # site_wlans_tsv_path() (all WLANs the controller returned) -- not the
  # config.yaml-mapped $WLANS_FILE, and not gated on AP-group data being
  # available. Gating this on the mapping, band applicability, or AP-group
  # resolution succeeding would misdetect an older-API controller as current
  # (or vice versa) whenever a site has partial mappings, 2.4-GHz-only
  # WLANs, or the apgroups fetch failed -- reintroducing the UWO-15 bug this
  # feature exists to fix.
  if [[ -s "$(site_wlans_tsv_path "$site")" ]]; then
    local _detect_row _detect_na_enabled _detect_na_rssi
    while IFS="$WLAN_FIELD_SEP" read -r \
      _dn _de _dbt _dfr _dmm _d24e _d24 _d5e _d5 _dbc _dme _dpa \
      _dwb _dwbs _dmlo _dsec _dwm _dw3s _dw3t _dpmf _dhs _dl2 \
      _dsac _dss _duap _ddm _dd24 _dd5 _dd6 _dgr _dabb \
      _detect_na_enabled _detect_na_rssi _dgm _dgi _; do
      if [[ -n "$_detect_na_enabled" || -n "$_detect_na_rssi" ]]; then
        : >>"$(roaming_field_present_flag_path "$site")"
        break
      fi
    done <"$(site_wlans_tsv_path "$site")"
  fi

  [[ -s "$(site_wlans_tsv_path "$site")" ]] || return 0

  # NOTE: deliberately no early return when site_apgroups_tsv_path() is
  # empty (e.g. fetch_site_apgroups() failed or the endpoint returned no
  # groups). A field-bearing WLAN must still get a roaming_wlan.tsv row --
  # "not_evaluable", via the empty-macs_field branch below -- instead of
  # silently having no row at all. No row here reads downstream
  # (print_general_check_roaming_assistant()) as "older API", which would
  # be wrong: the presence flag above already correctly recorded that the
  # field WAS seen, so the WLAN must show as unevaluable, not N/A.

  local wlan_row wlan_name ap_group_ids_field profile_name
  local current_site

  while IFS=$'\t' read -r current_site wlan_name profile_name; do
    [[ "$current_site" != "$site" ]] && continue

    wlan_row=$(get_site_wlan_row "$site" "$wlan_name")
    [[ -z "$wlan_row" ]] && continue

    IFS="$WLAN_FIELD_SEP" read -r \
      _name _enabled _bss_transition _fast_roaming \
      _minrate_mode \
      _minrate24_en _minrate24 _minrate5_en _minrate5 \
      _bc_filter _mcast_enhance _proxy_arp \
      wlan_band wlan_bands _mlo _security _wpa_mode _wpa3_support _wpa3_transition _pmf \
      _hide_ssid _l2_isolation _sae_anti_clogging _sae_sync _uapsd \
      _dtim_mode \
      _dtim24 _dtim5 _dtim6 _group_rekey _ap_name_in_beacon \
      na_enabled na_rssi _group_mode ap_group_ids_field _ <<<"$wlan_row"

    # A WLAN without the new SSID-level field (older controller/API) cannot
    # be evaluated on this path -- the site-wide fallback decision itself
    # is already made above, from the full API response.
    if [[ -z "$na_enabled" && -z "$na_rssi" ]]; then
      continue
    fi

    # Band applicability uses the *actual* controller configuration, not the
    # profile's expected bands (see print_general_check_roaming_assistant()).
    if ! wifi_band_includes "$(normalize_wifi_bands "$wlan_band" "$wlan_bands")" "5g"; then
      continue
    fi

    # Resolve broadcasting APs for this WLAN: ap_group_ids -> device_macs -> AP names.
    # A device_mac may belong to an AP that isn't configured under
    # neighbors: in config.yaml (so it's absent from APS_FILE) -- such an AP
    # still broadcasts the SSID and must not silently vanish from the
    # aggregation. site_devices_json_path() holds the full, unfiltered
    # stat/device response for the site (the same source build_site_inventory()
    # filters down into APS_FILE), so it's used here as a fallback name lookup.
    # broadcasting_aps/unresolved_macs are treated as sets, not lists:
    # ap_group_ids can reference multiple groups whose device_macs overlap
    # (e.g. a WLAN referencing both "All APs" and a more specific group that
    # is a subset of it), and deduping only at the end would let a single
    # physical AP masquerade as several -- turning a real single-AP WLAN
    # into an apparent multi-AP one, or skewing the min() aggregation with a
    # duplicated value. An ap_group_id with no matching row in
    # site_apgroups_tsv_path() (unknown/unresolvable group) is recorded as
    # its own incomplete reason instead of being silently dropped.
    # Bash 3.2 (macOS system bash) has no associative arrays, so "seen"
    # tracking uses a plain delimited string and glob matching instead --
    # MACs and AP names never contain spaces, so this is safe.
    local _seen_ap=" " _seen_mac=" "
    local broadcasting_aps=() unresolved_macs=() unresolved_group_ids=()
    local gid mac ap_name
    # Split the pipe-delimited fields into arrays with `read -a` -- an
    # unquoted `${var//|/ }` in a for-loop header would be subject to
    # both word-splitting AND pathname expansion, so a UniFi id or MAC
    # that happened to contain a shell glob metachar could silently
    # iterate over local filenames instead.
    local -a _gids _macs
    IFS='|' read -r -a _gids <<<"$ap_group_ids_field"
    for gid in "${_gids[@]}"; do
      local macs_field
      macs_field=$(awk -F "$WLAN_FIELD_SEP" -v id="$gid" '$1 == id { print $2; exit }' "$(site_apgroups_tsv_path "$site")")
      if [[ -z "$macs_field" ]]; then
        unresolved_group_ids+=("$gid")
        continue
      fi
      IFS='|' read -r -a _macs <<<"$macs_field"
      for mac in "${_macs[@]}"; do
        [[ "$_seen_mac" == *" ${mac} "* ]] && continue
        _seen_mac+="${mac} "
        ap_name=$(awk -F '\t' -v site="$site" -v mac="$mac" '$1 == site && $3 == mac { print $2; exit }' "$APS_FILE")
        if [[ -z "$ap_name" ]]; then
          ap_name=$(python3 -c "
import json, sys
try:
    with open(sys.argv[1], encoding='utf-8') as fh:
        data = json.load(fh).get('data', [])
    for dev in data:
        if dev.get('type') == 'uap' and dev.get('mac') == sys.argv[2]:
            print(dev.get('name', ''))
            break
except Exception:
    pass
" "$(site_devices_json_path "$site")" "$mac" 2>/dev/null)
        fi
        if [[ -n "$ap_name" ]]; then
          if [[ "$_seen_ap" != *" ${ap_name} "* ]]; then
            _seen_ap+="${ap_name} "
            broadcasting_aps+=("$ap_name")
          fi
        else
          unresolved_macs+=("$mac")
        fi
      done
    done

    if ((${#broadcasting_aps[@]} == 0)); then
      local _zero_reason="no broadcasting APs resolved from ap_group_ids"
      if ((${#unresolved_group_ids[@]} > 0)); then
        local _zero_ids
        _zero_ids=$(
          IFS=','
          echo "${unresolved_group_ids[*]}"
        )
        _zero_reason="no broadcasting APs resolved -- unresolvable AP group(s): ${_zero_ids}"
      fi
      printf '%s%s%snot_evaluable%s%s\n' "$wlan_name" "$WLAN_FIELD_SEP" "$WLAN_FIELD_SEP" "$WLAN_FIELD_SEP" "$_zero_reason" \
        >>"$(roaming_wlan_tsv_path "$site")"
      continue
    fi

    if ((${#broadcasting_aps[@]} == 1 && ${#unresolved_macs[@]} == 0 && ${#unresolved_group_ids[@]} == 0)); then
      printf '%s%s%sna%sno handoff target -- only one AP broadcasts this SSID\n' "$wlan_name" "$WLAN_FIELD_SEP" "$WLAN_FIELD_SEP" "$WLAN_FIELD_SEP" \
        >>"$(roaming_wlan_tsv_path "$site")"
      continue
    fi

    # Per broadcasting AP: SSID-filtered peer set, weakest sighting, corridor calc.
    # incomplete_reasons is seeded with any broadcasting AP that couldn't be
    # matched to config.yaml's neighbors: (or resolved to a name at all) --
    # a broadcasting AP outside local RF config is not silently dropped, since
    # the WLAN target can't be trusted as complete without it.
    local ap incomplete_reasons=() ap_values=() ap_value_names=()
    if ((${#unresolved_group_ids[@]} > 0)); then
      local ugid
      for ugid in "${unresolved_group_ids[@]}"; do
        incomplete_reasons+=("AP group ${ugid} referenced by this WLAN could not be resolved")
      done
    fi
    if ((${#unresolved_macs[@]} > 0)); then
      local umac
      for umac in "${unresolved_macs[@]}"; do
        incomplete_reasons+=("broadcasting AP with MAC ${umac} is not configured under neighbors: in config.yaml")
      done
    fi
    for ap in "${broadcasting_aps[@]}"; do
      local rf_neighbors ssid_peers=() peer
      rf_neighbors=$(get_peers "$site" "$ap")
      for peer in $rf_neighbors; do
        local is_broadcasting=false bcap
        for bcap in "${broadcasting_aps[@]}"; do
          [[ "$bcap" == "$peer" ]] && is_broadcasting=true && break
        done
        [[ "$is_broadcasting" == "true" ]] && ssid_peers+=("$peer")
      done

      if ((${#ssid_peers[@]} == 0)); then
        incomplete_reasons+=("${ap} has no configured RF neighbor broadcasting this SSID")
        continue
      fi

      # Direction matches analyze_band(): RSSI of *this AP* as seen in the
      # *peer's* scan cache (ALGORITHM.md §3, "RSSI @ Neighbor"). RSSI is not
      # symmetric, so this direction is deliberate, not incidental.
      local ap_mac ap_mac5g min_peer_rssi="" min_peer_name=""
      ap_mac=$(get_ap_mac "$site" "$ap")
      [[ -z "$ap_mac" ]] && continue
      ap_mac5g=$(mac_with_offset "$ap_mac" 2)

      local missing_peers=()
      for peer in "${ssid_peers[@]}"; do
        local peer_prefix peer_cache rssi_to
        peer_prefix=$(ap_scan_prefix "$site" "$peer")
        peer_cache=$(scan_rssi_cache_path "${peer_prefix}.5g")
        rssi_to=$(get_rssi "$ap_mac5g" "$peer_cache")
        if [[ -z "$rssi_to" ]]; then
          missing_peers+=("$peer")
          continue
        fi
        if [[ -z "$min_peer_rssi" ]] || ((rssi_to < min_peer_rssi)); then
          min_peer_rssi=$rssi_to
          min_peer_name=$peer
        fi
      done

      # Any missing sighting among this AP's SSID-relevant peers makes the
      # AP's value unreliable, even if other peers were sighted -- a partial
      # data set must not silently produce a value as if it were complete.
      if ((${#missing_peers[@]} > 0)); then
        local missing_peer
        for missing_peer in "${missing_peers[@]}"; do
          incomplete_reasons+=("${ap}: neighbor ${missing_peer} not sighted")
        done
        continue
      fi

      calculate_roaming_recommendation "$min_peer_rssi"
      ap_values+=("$_result")
      ap_value_names+=("${ap}|${min_peer_name}|${min_peer_rssi}|${_roam_raw_cap}|${_roam_warn}")
    done

    if ((${#ap_values[@]} == 0)); then
      local reason
      reason=$(
        IFS='|'
        echo "${incomplete_reasons[*]}"
      )
      printf '%s%s%snot_evaluable%s%s\n' "$wlan_name" "$WLAN_FIELD_SEP" "$WLAN_FIELD_SEP" "$WLAN_FIELD_SEP" "$reason" >>"$(roaming_wlan_tsv_path "$site")"
      continue
    fi

    # Aggregate WLAN target as min() over complete per-AP values (conservative).
    local wlan_min=""
    local v
    for v in "${ap_values[@]}"; do
      if [[ -z "$wlan_min" ]] || ((v < wlan_min)); then
        wlan_min=$v
      fi
    done

    local completeness="ok"
    if ((${#incomplete_reasons[@]} > 0)); then
      completeness="incomplete"
    fi

    local reasons_joined=""
    if ((${#incomplete_reasons[@]} > 0)); then
      reasons_joined=$(
        IFS='|'
        echo "${incomplete_reasons[*]}"
      )
    fi

    printf '%s%s%s%s%s%s%s\n' "$wlan_name" "$WLAN_FIELD_SEP" "$wlan_min" "$WLAN_FIELD_SEP" "$completeness" "$WLAN_FIELD_SEP" "$reasons_joined" \
      >>"$(roaming_wlan_tsv_path "$site")"

    # Every AP whose own value equals the WLAN-wide min() is a limiting AP
    # (ties are all reported, sorted by name for deterministic output).
    local idx entry_ap entry_peer entry_peer_rssi entry_raw_cap entry_warn
    local -a limiting_rows=()
    for idx in "${!ap_value_names[@]}"; do
      if ((ap_values[idx] == wlan_min)); then
        IFS='|' read -r entry_ap entry_peer entry_peer_rssi entry_raw_cap entry_warn <<<"${ap_value_names[$idx]}"
        limiting_rows+=("${entry_ap}"$'\t'"${entry_peer}"$'\t'"${entry_peer_rssi}"$'\t'"${entry_raw_cap}"$'\t'"${entry_warn}")
      fi
    done
    printf '%s\n' "${limiting_rows[@]}" | sort | while IFS=$'\t' read -r entry_ap entry_peer entry_peer_rssi entry_raw_cap entry_warn; do
      printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$wlan_name" "$entry_ap" "$entry_peer" "$entry_peer_rssi" "$entry_raw_cap" "$entry_warn" \
        >>"$(roaming_detail_tsv_path "$site")"
    done
  done <"$WLANS_FILE"
}

# ============================================================================
# Output Functions
# ============================================================================

# Normalize UniFi-style booleans from multiple controller/API variants.
is_true() {
  case "$1" in
  True | true | TRUE | 1 | Yes | yes | YES | On | on | ON) return 0 ;;
  *) return 1 ;;
  esac
}

# Print "Enabled" or "Disabled" for a boolean-like input value.
bool_state() {
  is_true "$1" && echo "Enabled" || echo "Disabled"
}

# Convert a kbps rate into a human-readable Mbps string with trimmed decimals.
rate_mbps() {
  local kbps=$1 whole rem frac
  whole=$((kbps / 1000))
  rem=$((kbps % 1000))
  if ((rem == 0)); then
    echo "$whole"
    return
  fi

  frac=$(printf '%03d' "$rem")
  while [[ "$frac" == *0 ]]; do
    frac=${frac%0}
  done
  printf '%d.%s\n' "$whole" "$frac"
}

# Normalize a PMF setting to one of Required, Optional, or Disabled.
pmf_state() {
  case "$1" in
  required | Required) echo "Required" ;;
  optional | Optional) echo "Optional" ;;
  disabled | Disabled | "") echo "Disabled" ;;
  *) echo "$1" ;;
  esac
}

# Print the human-readable security protocol name for a WLAN's raw security fields.
security_protocol_state() {
  local security=$1 wpa_mode=$2 wpa3_support=$3 wpa3_transition=$4
  local enterprise=false

  case "$security" in
  wpaeap | wpa-enterprise | enterprise) enterprise=true ;;
  esac

  if [[ "$security" == "open" ]] && is_true "$wpa3_support" && is_true "$wpa3_transition"; then
    echo "Enhanced Open with Transition"
  elif [[ "$security" == "open" ]] && is_true "$wpa3_support"; then
    echo "Enhanced Open (OWE)"
  elif [[ "$security" == "open" ]]; then
    echo "Open"
  elif [[ "$enterprise" == "true" ]] && is_true "$wpa3_support" && is_true "$wpa3_transition"; then
    echo "WPA2/WPA3 Enterprise"
  elif [[ "$enterprise" == "true" ]] && is_true "$wpa3_support"; then
    echo "WPA3 Enterprise"
  elif [[ "$enterprise" == "true" ]] && [[ "$wpa_mode" == "wpa2" ]]; then
    echo "WPA2 Enterprise"
  elif is_true "$wpa3_support" && is_true "$wpa3_transition"; then
    echo "WPA2/WPA3"
  elif is_true "$wpa3_support"; then
    echo "WPA3"
  elif [[ "$wpa_mode" == "wpa2" ]]; then
    echo "WPA2"
  else
    echo "${security:-Unknown}"
  fi
}

# Return success if the security protocol name uses SAE (WPA3-Personal only --
# WPA3 Enterprise authenticates via 802.1X/EAP, not the SAE handshake, so it
# has no SAE Anti-clogging/Sync Time settings).
security_protocol_uses_sae() {
  case "$1" in
  WPA3 | WPA2/WPA3) return 0 ;;
  *) return 1 ;;
  esac
}

# Return success if the security protocol name is any WPA3 variant (Personal
# or Enterprise, transition or WPA3-only). Used for protocol-level rules like
# the MLO/6 GHz PMF requirement, which apply regardless of Personal/Enterprise.
security_protocol_uses_wpa3() {
  case "$1" in
  WPA3 | WPA2/WPA3 | "WPA3 Enterprise" | "WPA2/WPA3 Enterprise") return 0 ;;
  *) return 1 ;;
  esac
}

# Normalize UniFi band/bands fields into a pipe-separated list of 2g|5g|6g tokens.
normalize_wifi_bands() {
  local band=$1 bands=$2
  local source="${bands:-$band}"
  local normalized=""

  case "$source" in
  *2g* | *both* | *all*)
    normalized="2g"
    ;;
  esac

  case "$source" in
  *5g*)
    normalized="${normalized:+${normalized}|}5g"
    ;;
  *both* | *all*)
    [[ "$normalized" != *5g* ]] && normalized="${normalized:+${normalized}|}5g"
    ;;
  esac

  case "$source" in
  *6g* | *6e* | *all*)
    normalized="${normalized:+${normalized}|}6g"
    ;;
  esac

  echo "$normalized"
}

# Print a human-readable label for a normalized WiFi band token combination.
wifi_bands_state() {
  local normalized=$1
  case "$normalized" in
  2g) echo "2.4 GHz only" ;;
  5g) echo "5 GHz only" ;;
  6g) echo "6 GHz only" ;;
  2g\|5g) echo "2.4 GHz, 5 GHz" ;;
  2g\|6g) echo "2.4 GHz, 6 GHz" ;;
  5g\|6g) echo "5 GHz, 6 GHz" ;;
  2g\|5g\|6g) echo "2.4 GHz, 5 GHz, 6 GHz" ;;
  "") echo "n/a" ;;
  *) echo "$normalized" ;;
  esac
}

# Return success if the normalized band string includes the target token.
wifi_band_includes() {
  local normalized=$1 target=$2
  case "|$normalized|" in
  *"|$target|"*) return 0 ;;
  *) return 1 ;;
  esac
}

# Return success if the current security protocol is in the allowed pipe-separated list.
security_protocol_allowed() {
  local allowed=$1 current=$2 item
  IFS='|' read -r -a allowed_items <<<"$allowed"
  for item in "${allowed_items[@]}"; do
    [[ "$item" == "$current" ]] && return 0
  done
  return 1
}

# Format the allowed security protocol list for human-readable display.
security_protocol_expected_state() {
  local allowed=$1
  echo "${allowed//|/, }"
}

# Print a human-readable rekey interval label or "Disabled".
rekey_state() {
  local seconds=$1
  if [[ -z "$seconds" || "$seconds" == "0" || "$seconds" == "disabled" || "$seconds" == "Disabled" ]]; then
    echo "Disabled"
  else
    echo "${seconds} s"
  fi
}

# Normalize a rekey value to "0" for disabled or the numeric value otherwise.
normalize_rekey() {
  local value=$1
  if [[ -z "$value" || "$value" == "0" || "$value" == "disabled" || "$value" == "Disabled" ]]; then
    echo "0"
  else
    echo "$value"
  fi
}

# Normalize a minimum-data-rate mode string to "auto" or "manual".
normalize_minrate_mode() {
  local value
  value=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
  case "$value" in
  auto | "") echo "auto" ;;
  manual) echo "manual" ;;
  *) echo "$1" ;;
  esac
}

# Print the display label ("Auto" or "Manual") for a minimum-data-rate mode.
minrate_mode_state() {
  case "$(normalize_minrate_mode "$1")" in
  auto) echo "Auto" ;;
  manual) echo "Manual" ;;
  *) echo "$1" ;;
  esac
}

# Normalize a DTIM mode string to "default" or "custom".
normalize_dtim_mode() {
  local value
  value=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
  case "$value" in
  default | "") echo "default" ;;
  custom) echo "custom" ;;
  *) echo "$1" ;;
  esac
}

# Print the display label ("Default" or "Custom") for a DTIM mode.
dtim_mode_state() {
  case "$(normalize_dtim_mode "$1")" in
  default) echo "Default" ;;
  custom) echo "Custom" ;;
  *) echo "$1" ;;
  esac
}

