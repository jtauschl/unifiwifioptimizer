# Print the end-of-report footer with re-run and DFS CAC notes when applicable.
print_footer() {
  local has_changes=$1
  local has_active_dfs_cac=${2:-false}
  if [[ "$has_changes" == "true" ]]; then
    echo
    printf "  %sAfter applying changes, please run this script again.\n" "$YELLOW"
  fi
  if [[ "$has_active_dfs_cac" == "true" ]]; then
    [[ "$has_changes" != "true" ]] && echo
    printf "  %sNote: At least one 5 GHz AP is currently in DFS CAC.\n" "$YELLOW"
    printf "  Wait until all affected access points have activated the channel\n"
    printf "  before re-running.%s\n" "$RESET"
  fi
  print_scope_note
  echo
}

# Print the scope statement -- what this tool cannot verify. Once per run,
# regardless of pending changes. Aligns with the WLAN-Pros community norm
# to state a tool's scope explicitly rather than let it be oversold as a
# spectrum-analysis or client-telemetry equivalent.
print_scope_note() {
  echo
  printf "  %sScope note:%s this tool works from UniFi controller configuration\n" "$CYAN" "$RESET"
  printf "  and AP-to-AP neighbor scans. It cannot see non-WiFi RF interference\n"
  printf "  (BLE/Zigbee/microwave -- needs a spectrum analyzer), per-client MCS\n"
  printf "  or retry statistics, real client roaming timing, or packet captures.\n"
  printf "  Neighbor RSSI is an AP-to-AP beacon reading, not a client link-budget\n"
  printf "  proxy -- it cannot detect a weak client's uplink being marginal even\n"
  printf "  when the corridor looks compliant. Recommendations are static-analysis\n"
  printf "  heuristics, not runtime KPIs.\n"
}

# Print a hint explaining why no neighbor data was found, when the channel is DFS.
print_no_neighbor_note() {
  local channel=$1 dfs_enabled=$2 cac_state=$3

  [[ "$dfs_enabled" != "true" ]] && return 0

  case "$cac_state" in
  active)
    printf "  ${YELLOW}Note: Channel %s is currently in DFS CAC on this AP — MAC TX is still disabled. Re-run after ~60s.${RESET}\n" "$channel"
    ;;
  ready)
    printf '%s\n' "  ${YELLOW}Note: DFS CAC appears complete on this AP — missing neighbor data is more likely caused by very low TX power or limited overlap.${RESET}"
    ;;
  *)
    printf "  ${YELLOW}Note: Channel %s is a DFS channel, but CAC state could not be verified on this AP.${RESET}\n" "$channel"
    ;;
  esac
}

# Print channel-overlap, width-budget, and missing-sighting issues for adjacency groups.
print_group_issues() {
  local site=$1
  local section_printed=false
  local group_label members_csv
  local issues infos width24_total width5_total width24_headroom width5_headroom
  local members member i j ap_a ap_b
  local radio_info ch24 ht24 _tx24 _min_tx24 _max_tx24 _txmode24 _min_rssi24 _min_rssi_en24
  local ch5 ht5 _tx5 _min_tx5 _max_tx5 _txmode5 _min_rssi5 _min_rssi_en5 _roam_enabled _roam_rssi _ib24 _ib5 _dfs5
  local overlap_items missing_items peer_cache_a peer_cache_b
  local mac_a mac_b mac_a_band mac_b_band sight_a_to_b sight_b_to_a
  local pair_label

  while IFS=$'\t' read -r group_label members_csv; do
    [[ -z "$group_label" ]] && continue
    issues=()
    infos=()
    width24_total=0
    width5_total=0
    width24_headroom=0
    width5_headroom=0
    overlap_items=()
    missing_items=()
    IFS=',' read -r -a members <<<"$members_csv"

    for member in "${members[@]}"; do
      radio_info=$(get_radio_info "$site" "$member")
      IFS='|' read -r \
        ch24 ht24 _tx24 _min_tx24 _max_tx24 _txmode24 _min_rssi24 _min_rssi_en24 \
        ch5 ht5 _tx5 _min_tx5 _max_tx5 _txmode5 _min_rssi5 _min_rssi_en5 \
        _roam_enabled _roam_rssi _ib24 _ib5 _dfs5 <<<"$radio_info"
      [[ "$ht24" =~ ^[0-9]+$ ]] || ht24=20
      [[ "$ht5" =~ ^[0-9]+$ ]] || ht5=20
      width24_total=$((width24_total + ht24))
      width5_total=$((width5_total + ht5))
    done

    ((width24_total > 60)) && issues+=("2.4 GHz width mix ${width24_total} MHz exceeds the 60 MHz clean-spectrum budget")
    ((width5_total > 320)) && issues+=("5 GHz width mix ${width5_total} MHz exceeds the 320 MHz local-spectrum budget")

    for ((i = 0; i < ${#members[@]}; i++)); do
      for ((j = i + 1; j < ${#members[@]}; j++)); do
        ap_a=${members[i]}
        ap_b=${members[j]}
        aps_are_peers "$site" "$ap_a" "$ap_b" || continue

        radio_info=$(get_radio_info "$site" "$ap_a")
        IFS='|' read -r \
          ch24 ht24 _tx24 _min_tx24 _max_tx24 _txmode24 _min_rssi24 _min_rssi_en24 \
          ch5 ht5 _tx5 _min_tx5 _max_tx5 _txmode5 _min_rssi5 _min_rssi_en5 \
          _roam_enabled _roam_rssi _ib24 _ib5 _dfs5 <<<"$radio_info"
        radio_info=$(get_radio_info "$site" "$ap_b")
        IFS='|' read -r \
          peer_ch24 peer_ht24 _peer_tx24 _peer_min_tx24 _peer_max_tx24 _peer_txmode24 _peer_min_rssi24 _peer_min_rssi_en24 \
          peer_ch5 peer_ht5 _peer_tx5 _peer_min_tx5 _peer_max_tx5 _peer_txmode5 _peer_min_rssi5 _peer_min_rssi_en5 \
          _peer_roam_enabled _peer_roam_rssi _peer_ib24 _peer_ib5 _peer_dfs5 <<<"$radio_info"

        if channels_overlap "2g" "$ch24" "${ht24:-20}" "$peer_ch24" "${peer_ht24:-20}"; then
          overlap_items+=("2.4 GHz ${ap_a}/${ap_b}")
        fi
        if channels_overlap "5g" "$ch5" "${ht5:-20}" "$peer_ch5" "${peer_ht5:-20}"; then
          overlap_items+=("5 GHz ${ap_a}/${ap_b}")
        fi

        mac_a=$(get_ap_mac "$site" "$ap_a")
        mac_b=$(get_ap_mac "$site" "$ap_b")
        [[ -z "$mac_a" || -z "$mac_b" ]] && continue

        mac_a_band=$(mac_with_offset "$mac_a" 1)
        mac_b_band=$(mac_with_offset "$mac_b" 1)
        peer_cache_a=$(scan_rssi_cache_path "$(ap_scan_prefix "$site" "$ap_a").2g")
        peer_cache_b=$(scan_rssi_cache_path "$(ap_scan_prefix "$site" "$ap_b").2g")
        sight_a_to_b=$(get_rssi "$mac_b_band" "$peer_cache_a")
        sight_b_to_a=$(get_rssi "$mac_a_band" "$peer_cache_b")
        pair_label="2.4 GHz ${ap_a}/${ap_b}"
        if [[ -z "$sight_a_to_b" || -z "$sight_b_to_a" ]]; then
          if [[ -z "$sight_a_to_b" && -z "$sight_b_to_a" ]]; then
            missing_items+=("${pair_label} missing both directions")
          elif [[ -z "$sight_a_to_b" ]]; then
            missing_items+=("${pair_label} missing ${ap_a}->${ap_b}")
          else
            missing_items+=("${pair_label} missing ${ap_b}->${ap_a}")
          fi
        fi

        mac_a_band=$(mac_with_offset "$mac_a" 2)
        mac_b_band=$(mac_with_offset "$mac_b" 2)
        peer_cache_a=$(scan_rssi_cache_path "$(ap_scan_prefix "$site" "$ap_a").5g")
        peer_cache_b=$(scan_rssi_cache_path "$(ap_scan_prefix "$site" "$ap_b").5g")
        sight_a_to_b=$(get_rssi "$mac_b_band" "$peer_cache_a")
        sight_b_to_a=$(get_rssi "$mac_a_band" "$peer_cache_b")
        pair_label="5 GHz ${ap_a}/${ap_b}"
        if [[ -z "$sight_a_to_b" || -z "$sight_b_to_a" ]]; then
          if [[ -z "$sight_a_to_b" && -z "$sight_b_to_a" ]]; then
            missing_items+=("${pair_label} missing both directions")
          elif [[ -z "$sight_a_to_b" ]]; then
            missing_items+=("${pair_label} missing ${ap_a}->${ap_b}")
          else
            missing_items+=("${pair_label} missing ${ap_b}->${ap_a}")
          fi
        fi
      done
    done

    if ((${#overlap_items[@]} > 0)); then
      issues+=("overlapping adjacent channels: ${overlap_items[*]}")
    fi
    if ((${#missing_items[@]} > 0)); then
      issues+=("missing peer sightings: ${missing_items[*]}")
    fi

    if ((${#issues[@]} == 0)); then
      width24_headroom=$((60 - width24_total))
      width5_headroom=$((320 - width5_total))
      ((width24_headroom > 0)) && infos+=("available 2.4 GHz headroom: ${width24_headroom} MHz")
      ((width5_headroom > 0)) && infos+=("available 5 GHz headroom: ${width5_headroom} MHz")
    fi

    if ((${#issues[@]} == 0 && ${#infos[@]} == 0)); then
      continue
    fi

    if [[ "$section_printed" != "true" ]]; then
      print_group_summary_header
      section_printed=true
    fi

    printf '  %s%s%s\n' "$CYAN" "$group_label" "$RESET"
    if ((${#issues[@]} > 0)); then
      for member in "${issues[@]}"; do
        printf '  %s! %s%s\n' "$YELLOW" "$member" "$RESET"
      done
    fi
    if ((${#infos[@]} > 0)); then
      for member in "${infos[@]}"; do
        printf '  %s· %s%s\n' "$GREEN" "$member" "$RESET"
      done
    fi
    echo
  done < <(list_site_groups "$site")
}

# Analyze one band on one AP: print neighbors, warnings and per-radio recommendations.
analyze_band() {
  local band_label=$1 band_key=$2 scan_prefix=$3 mac=$4 ht=$5 channel=$6 tx=$7 min_tx=$8 max_tx=$9
  local txmode=${10} min_rssi=${11} min_rssi_enabled=${12} ib_enabled=${13} dfs_enabled=${14} cac_state=${15} include_roaming=${16}
  local band_has_radio_hint=${17:-false}
  local scan_file="${scan_prefix}.${band_key}"
  local tx_uncapped=$tx rec_tx=$tx rec_rssi=$TX_LO roam_recommended=$ROAM_TARGET
  local current_width peer_count=0
  local width_budget=0 width_over_budget=false width_oversubscribed=false
  local peer_channel peer_width overlap_warn=""
  local _sum_rssi=0 _count_nbr=0 _i=0 _delta _shift_applied _proj
  local shift peer peer_prefix peer_cache rssi_to _j peer_radio_info
  local _warn_lo="" _warn_lo_raw="" _warn_hi="" _missing_warn=""
  local _nbr_peer=() _nbr_rssi=() _nbr_warn=()
  local _min_nbr_rssi="" _roam_warn="" _roam_raw_cap=""
  local _missing_peer=()
  local _overlap_peer=()
  local _has_missing_peer_partial=false tx_zero_sightings=false

  current_width=${ht:-20}

  if grep -qF '===NO_RADIO===' "$scan_file" 2>/dev/null; then
    if [[ "$band_has_radio_hint" != "true" ]]; then
      echo "  ${band_label} GHz: band not active"
      return
    fi
  fi

  print_channel_info "$band_label" "$ht" "$channel" "$tx" "$dfs_enabled"

  for peer in $peers; do
    peer_count=$((peer_count + 1))
  done

  width_budget=320
  [[ "$band_key" == "2g" ]] && width_budget=60
  if [[ "$band_key" == "2g" && $peer_count -gt 3 ]]; then
    width_oversubscribed=true
  fi

  for peer in $peers; do
    peer_radio_info=$(get_radio_info "$site" "$peer")
    IFS='|' read -r \
      peer_ch24 peer_ht24 _peer_tx24 _peer_min_tx24 _peer_max_tx24 _peer_txmode24 _peer_min_rssi24 _peer_min_rssi_en24 \
      peer_ch5 peer_ht5 _peer_tx5 _peer_min_tx5 _peer_max_tx5 _peer_txmode5 _peer_min_rssi5 _peer_min_rssi_en5 \
      _peer_roam_enabled _peer_roam_rssi _peer_ib24 _peer_ib5 _peer_dfs5 <<<"$peer_radio_info"
    if [[ "$band_key" == "2g" ]]; then
      peer_channel=${peer_ch24:-}
      peer_width=${peer_ht24:-20}
    else
      peer_channel=${peer_ch5:-}
      peer_width=${peer_ht5:-20}
    fi
    [[ "$peer_width" =~ ^[0-9]+$ ]] || peer_width=20
    if ((current_width + peer_width > 0)); then
      width_budget=$((width_budget - peer_width))
    fi
    if channels_overlap "$band_key" "$channel" "$current_width" "$peer_channel" "$peer_width"; then
      _overlap_peer+=("$peer")
    fi

    peer_prefix="${_peer_prefixes[$_i]}"
    _i=$((_i + 1))
    peer_cache=$(scan_rssi_cache_path "${peer_prefix}.${band_key}")
    rssi_to=$(get_rssi "$mac" "$peer_cache")
    if [[ -n "$rssi_to" ]]; then
      _nbr_peer+=("$peer")
      _nbr_rssi+=("$rssi_to")
      if [[ -z "$_min_nbr_rssi" ]] || ((rssi_to < _min_nbr_rssi)); then
        _min_nbr_rssi=$rssi_to
      fi
      _sum_rssi=$((_sum_rssi + rssi_to))
      _count_nbr=$((_count_nbr + 1))
    else
      _missing_peer+=("$peer")
    fi
  done

  _has_missing_peer_partial=false
  ((${#_missing_peer[@]} > 0)) && _has_missing_peer_partial=true
  calculate_tx_recommendation "$tx" "$min_tx" "$max_tx" "$_sum_rssi" "$_count_nbr" \
    "$peer_count" "$_has_missing_peer_partial"
  rec_tx=$_result
  tx_uncapped=$_tx_uncapped
  tx_zero_sightings=$_tx_zero_sightings

  if [[ $_count_nbr -gt 0 ]]; then
    calculate_min_rssi_recommendation
    rec_rssi=$_result
    if [[ "$band_key" == "5g" && "$include_roaming" == "true" ]]; then
      calculate_roaming_recommendation "$_min_nbr_rssi"
      roam_recommended=$_result
    fi
  fi

  if [[ $_count_nbr -gt 0 ]]; then
    # Two separate diagnoses for weak neighbors:
    #   lo_raw:       raw RSSI is already below TX_LO, and applying the
    #                 recommended shift projects this specific neighbor back
    #                 into the corridor (checked below, unconditionally --
    #                 rec_tx is derived from the AVERAGE neighbor RSSI, so a
    #                 shift that resolves the average does not automatically
    #                 resolve every individual neighbor).
    #   lo_unfixable: applying the recommended shift still leaves the
    #                 projected RSSI below TX_LO for this neighbor -- whether
    #                 because the radio is already at its TX limit (the
    #                 original capped case) or because the averaged shift
    #                 itself doesn't move this specific neighbor enough. This
    #                 is a hard coverage gap and the traditional "Coverage
    #                 gap" warning either way.
    # lo_unfixable wins over lo_raw on the same neighbor.
    for _j in "${!_nbr_peer[@]}"; do
      ((_nbr_rssi[_j] < TX_LO)) && _nbr_warn[_j]="lo_raw"
    done

    _shift_applied=$((rec_tx - tx))
    for _j in "${!_nbr_peer[@]}"; do
      [[ "${_nbr_warn[$_j]:-}" == "lo_raw" ]] || continue
      _proj=$((_nbr_rssi[_j] + _shift_applied))
      ((_proj < TX_LO)) && _nbr_warn[_j]="lo_unfixable"
    done

    if ((tx_uncapped < min_tx)); then
      for _j in "${!_nbr_peer[@]}"; do
        _proj=$((_nbr_rssi[_j] + _shift_applied))
        ((_proj > TX_HI)) && _nbr_warn[_j]="hi"
      done
    fi
  fi

  print_neighbor_header
  for _j in "${!_nbr_peer[@]}"; do
    case "${_nbr_warn[$_j]:-}" in
    lo_raw) _marker="°" ;;
    lo_unfixable | hi) _marker="*" ;;
    *) _marker="" ;;
    esac
    print_neighbor_row "${_nbr_peer[$_j]}" "${_nbr_rssi[$_j]}" "$_marker"
  done

  for _j in "${!_nbr_peer[@]}"; do
    case "${_nbr_warn[$_j]:-}" in
    lo_raw) _warn_lo_raw+="${_nbr_peer[$_j]} " ;;
    lo_unfixable) _warn_lo+="${_nbr_peer[$_j]} " ;;
    hi) _warn_hi+="${_nbr_peer[$_j]} " ;;
    esac
  done

  if [[ -n "$_warn_lo" ]]; then
    printf "\n  ${YELLOW}* Coverage gap – signal too weak at: %s${RESET}\n" "${_warn_lo% }"
    printf '  %s  Consider repositioning this AP or adding a neighbor AP.%s\n' "$YELLOW" "$RESET"
  fi
  if [[ -n "$_warn_lo_raw" ]]; then
    printf "\n  ${YELLOW}° Below corridor before TX adjustment at: %s${RESET}\n" "${_warn_lo_raw% }"
    printf '  %s  Raw RSSI is below TX_LO; applying the Transmit Power recommendation above brings this neighbor into the corridor.%s\n' "$YELLOW" "$RESET"
  fi
  if [[ -n "$_warn_hi" ]]; then
    printf "\n  ${YELLOW}* Excess overlap – signal too strong at: %s${RESET}\n" "${_warn_hi% }"
    printf '  %s  Consider repositioning or removing this AP.%s\n' "$YELLOW" "$RESET"
  fi
  if [[ "$include_roaming" == "true" ]]; then
    case "$_roam_warn" in
    capped_by_margin)
      printf "\n  ${YELLOW}* Roaming Assistant lowered to %d dBm: weakest neighbor %d dBm is below TX_LO (%d dBm), threshold tracks min(neighbor) − %d dB margin.${RESET}\n" \
        "$roam_recommended" "$_min_nbr_rssi" "$TX_LO" "$ROAM_MARGIN_DB"
      printf '  %s  Coverage-limited recommendation — fix AP placement; threshold tuning cannot replace overlap.%s\n' "$YELLOW" "$RESET"
      ;;
    capped_by_floor)
      printf "\n  ${YELLOW}* Roaming Assistant clamped to ROAM_FLOOR (%d dBm): weakest neighbor %d dBm would yield %d dBm (below floor).${RESET}\n" \
        "$roam_recommended" "$_min_nbr_rssi" "$_roam_raw_cap"
      printf '  %s  No reachable roaming neighbor at this AP — fix AP placement; threshold tuning cannot replace overlap.%s\n' "$YELLOW" "$RESET"
      ;;
    esac
  fi
  if ((${#_missing_peer[@]} > 0)); then
    _missing_warn="${_missing_peer[*]}"
    printf "\n  ${YELLOW}* Adjacent APs without sighting: %s${RESET}\n" "$_missing_warn"
    printf '  %s  Reduction is blocked until all configured neighbors can see this AP.%s\n' "$YELLOW" "$RESET"
  fi
  if ((current_width > width_budget)); then
    width_over_budget=true
  fi
  if [[ "$width_over_budget" == "true" ]]; then
    if [[ "$band_key" == "5g" ]]; then
      printf "\n  ${YELLOW}* Current 5 GHz width exceeds the local adjacency budget: %d MHz within %d MHz of usable spectrum.${RESET}\n" "$current_width" $((current_width + (320 - width_budget)))
      printf '  %s  This adjacency group needs a narrower mix of channel widths to fit into 320 MHz.%s\n' "$YELLOW" "$RESET"
    else
      printf "\n  ${YELLOW}* Current 2.4 GHz width exceeds the local adjacency budget: %d MHz within %d MHz of clean spectrum.${RESET}\n" "$current_width" $((current_width + (60 - width_budget)))
      printf '  %s  This adjacency group is wider than the clean 2.4 GHz spectrum allows.%s\n' "$YELLOW" "$RESET"
    fi
  elif [[ "$width_oversubscribed" == "true" ]]; then
    printf "\n  ${YELLOW}* 2.4 GHz is oversubscribed: %d adjacent APs share only the clean channels 1/6/11.${RESET}\n" "$peer_count"
    printf '  %s  Channel width cannot be reduced below 20 MHz; use TX control, AP placement or 5 GHz steering instead.%s\n' "$YELLOW" "$RESET"
  fi
  if ((${#_overlap_peer[@]} > 0)); then
    overlap_warn="${_overlap_peer[*]}"
    if [[ "$band_key" == "5g" ]]; then
      printf "\n  ${YELLOW}* Channel overlap with adjacent APs: %s${RESET}\n" "$overlap_warn"
      printf '  %s  Even with the current width, these 5 GHz channels share spectrum and should be separated if possible.%s\n' "$YELLOW" "$RESET"
    else
      printf "\n  ${YELLOW}* Channel overlap with adjacent APs: %s${RESET}\n" "$overlap_warn"
      printf '  %s  In 2.4 GHz, keep adjacent APs on the clean channels 1/6/11 whenever possible.%s\n' "$YELLOW" "$RESET"
    fi
  fi

  if [[ $_count_nbr -gt 0 ]]; then
    print_recommendations_header
    print_rec_channel_layout "$overlap_warn"
    print_rec_tx "$rec_tx" "$txmode" "$tx"
    if [[ "$include_roaming" == "true" ]]; then
      print_rec_roaming "$roam_recommended" "$roam_enabled" "$roam_rssi"
    fi
    print_rec_min_rssi "$rec_rssi" "$min_rssi_enabled" "$min_rssi"
    if is_true "$min_rssi_enabled"; then
      print_rec_interference_blocker "$ib_enabled"
    fi
  else
    echo
    echo "  No neighbor data for ${band_label} GHz"
    if ((${#_overlap_peer[@]} > 0)) || [[ "$tx_zero_sightings" == "true" ]]; then
      print_recommendations_header
      print_rec_channel_layout "$overlap_warn"
      if [[ "$tx_zero_sightings" == "true" ]]; then
        print_rec_tx_zero_sightings "$rec_tx" "$txmode" "$tx"
      fi
    fi
    if [[ "$band_key" == "5g" ]]; then
      print_no_neighbor_note "$channel" "$dfs_enabled" "$cac_state"
    fi
  fi
}

# Return the tmpdir path prefix used for a site's AP-specific scan cache files.
ap_scan_prefix() {
  local site=$1 ap=$2
  printf "%s/%s__%s" "$tmpdir" "$(sanitize_token "$site")" "$(sanitize_token "$ap")"
}

# ============================================================================
# Main
# ============================================================================

# Parse CLI arguments and drive the full scan-analyze-report workflow.
main() {
  validate_roam_constants

  tmpdir=$(mktemp -d)
  trap '[[ -n "$tmpdir" && -d "$tmpdir" ]] && rm -rf "$tmpdir"' EXIT

  ENV_FILE="${tmpdir}/controller.env"
  SITES_FILE="${tmpdir}/sites.tsv"
  WLANS_FILE="${tmpdir}/wlans.tsv"
  NEIGHBORS_FILE="${tmpdir}/neighbors.tsv"
  PROFILES_TSV="${tmpdir}/profiles.tsv"
  APS_FILE="${tmpdir}/aps.tsv"
  CONTROLLER_SITES_FILE="${tmpdir}/controller-sites.txt"

  # ==========================================================================
  # Main: Scanning
  # ==========================================================================

  MODE="run"
  SITE_SELECTOR=""

  case "${1:-}" in
  "")
    ;;
  --sites)
    [[ $# -eq 1 ]] || {
      print_usage >&2
      exit 1
    }
    MODE="sites"
    ;;
  --site)
    [[ $# -eq 2 ]] || {
      print_usage >&2
      exit 1
    }
    MODE="site"
    SITE_SELECTOR=$2
    ;;
  --config)
    [[ $# -eq 2 ]] || {
      print_usage >&2
      exit 1
    }
    MODE="config"
    SITE_SELECTOR=$2
    ;;
  -h | --help)
    print_usage
    exit 0
    ;;
  *)
    printf 'ERROR: Unknown argument: %s\n' "$1" >&2
    print_usage >&2
    exit 1
    ;;
  esac

  require_config_file
  load_controller_config

  case "$MODE" in
  sites)
    fetch_controller_sites
    show_sites
    exit 0
    ;;
  site)
    fetch_controller_sites
    show_site_env "$SITE_SELECTOR"
    exit 0
    ;;
  config)
    fetch_controller_sites
    print_config_skeleton "$SITE_SELECTOR"
    exit 0
    ;;
  esac

  require_profiles_file
  load_yaml_config
  check_dependencies

  print_header
  echo "  Detecting environment..."
  echo

  build_site_inventory
  SITE_COUNT=$(wc -l <"$SITES_FILE" | tr -d '[:space:]')

  echo "  Scanning access points..."

  MAX_SCAN_PASSES=$(awk -F '\t' '$6+0 > max { max=$6+0 } END { print (max<1?1:max) }' "$SITES_FILE")
  MAX_SCAN_PASSES=$((MAX_SCAN_PASSES > 0 ? MAX_SCAN_PASSES : 1))

  current_scan_site=""
  current_site_ssh_user=""
  current_site_ssh_password=""
  current_site_scan_passes=1

  _scan_pass=1
  while ((_scan_pass <= MAX_SCAN_PASSES)); do
    while IFS=$'\t' read -r site ap mac ip _model; do
      [[ -z "$site" ]] && continue
      scan_prefix=$(ap_scan_prefix "$site" "$ap")

      if [[ "$site" != "$current_scan_site" ]]; then
        IFS=$'\t' read -r current_site_ssh_user current_site_ssh_password <<<"$(site_ssh_credentials "$site")"
        current_site_scan_passes=$(awk -F '\t' -v s="$site" '$1==s { print ($6==""||$6+0<1)?1:$6+0; exit }' "$SITES_FILE")
        current_site_scan_passes=$((current_site_scan_passes > 0 ? current_site_scan_passes : 1))
        current_scan_site="$site"
      fi

      ((_scan_pass > current_site_scan_passes)) && continue

      if ((current_site_scan_passes > 1)); then
        echo "    Scanning ${site}/${ap} (pass ${_scan_pass}/${current_site_scan_passes})..."
        raw_file="${scan_prefix}.raw.${_scan_pass}"
      else
        echo "    Scanning ${site}/${ap}..."
        raw_file="${scan_prefix}.raw"
      fi

      scan_err_file="${scan_prefix}.err"
      if ! ssh_scan_ap "${current_site_ssh_user}@${ip}" "$current_site_ssh_password" >"$raw_file" 2>"$scan_err_file"; then
        : >"$raw_file"
        if [[ -s "$scan_err_file" ]]; then
          printf "    SSH failed: %s\n" "$(tr '\n' ' ' <"$scan_err_file" | sed 's/[[:space:]]\+/ /g; s/^ //; s/ $//')"
        else
          echo "    SSH failed: no details returned"
        fi
      fi

      if ((current_site_scan_passes > 1)); then
        awk '/^===5GHZ===/ { exit } { print }' "$raw_file" >"${scan_prefix}.2g.${_scan_pass}"
        awk 'found { print } /^===5GHZ===/ { found=1 }' "$raw_file" >"${scan_prefix}.5g.${_scan_pass}"
        build_rssi_cache_file_with_channels \
          "${scan_prefix}.2g.${_scan_pass}" \
          "${scan_prefix}.2g.${_scan_pass}.rssi" \
          "${scan_prefix}.2g.${_scan_pass}.chan"
        build_rssi_cache_file_with_channels \
          "${scan_prefix}.5g.${_scan_pass}" \
          "${scan_prefix}.5g.${_scan_pass}.rssi" \
          "${scan_prefix}.5g.${_scan_pass}.chan"
      else
        awk '/^===5GHZ===/ { exit } { print }' "$raw_file" >"${scan_prefix}.2g"
        awk 'found { print } /^===5GHZ===/ { found=1 }' "$raw_file" >"${scan_prefix}.5g"
        build_rssi_cache_file "${scan_prefix}.2g" "$(scan_rssi_cache_path "${scan_prefix}.2g")"
        build_rssi_cache_file "${scan_prefix}.5g" "$(scan_rssi_cache_path "${scan_prefix}.5g")"
      fi
    done <"$APS_FILE"
    current_scan_site=""
    _scan_pass=$((_scan_pass + 1))
  done

  # Aggregate multi-pass results into final .rssi cache files
  if ((MAX_SCAN_PASSES > 1)); then
    while IFS=$'\t' read -r site ap mac ip _model; do
      [[ -z "$site" ]] && continue
      scan_prefix=$(ap_scan_prefix "$site" "$ap")
      site_passes=$(awk -F '\t' -v s="$site" '$1==s { print ($6==""?1:$6+0); exit }' "$SITES_FILE")
      # Find the last pass with a non-empty raw file to preserve ===NO_RADIO=== markers
      # from a successful scan when a later pass fails over SSH.
      last_good_pass=$site_passes
      while ((last_good_pass > 1)); do
        [[ -s "${scan_prefix}.raw.${last_good_pass}" ]] && break
        last_good_pass=$((last_good_pass - 1))
      done
      cp "${scan_prefix}.raw.${last_good_pass}" "${scan_prefix}.raw" 2>/dev/null || : >"${scan_prefix}.raw"
      cp "${scan_prefix}.2g.${last_good_pass}" "${scan_prefix}.2g" 2>/dev/null || : >"${scan_prefix}.2g"
      cp "${scan_prefix}.5g.${last_good_pass}" "${scan_prefix}.5g" 2>/dev/null || : >"${scan_prefix}.5g"
      aggregate_rssi_passes "$scan_prefix" "2g" "$site_passes"
      aggregate_rssi_passes "$scan_prefix" "5g" "$site_passes"
    done <"$APS_FILE"
  fi

  echo
  echo "  Analyzing recommendations..."
  echo

  # ============================================================================
  # Main: Analysis & Output
  # ============================================================================
  has_changes=false
  has_active_dfs_cac=false

  while IFS=$'\t' read -r site n env_label _ssh_user _ssh_password; do
    [[ -z "$site" ]] && continue

    # Compute TX corridor for this site from path loss model
    TX_LO=$(awk "BEGIN { printf \"%.0f\", $ROAM_TARGET - 10*$n*log(100/$OVERLAP_DIST)/log(10) }")
    TX_HI=$((TX_LO + CORRIDOR_WIDTH))

    if ((SITE_COUNT > 1)); then
      print_site_header "$site"
    fi

    print_environment_header
    printf "  %-26s %s\n" "Environment:" "$env_label"
    printf "  %-26s %d dBm to %d dBm\n" "Target RSSI @ Neighbor:" "$TX_LO" "$TX_HI"
    printf "  %-26s %d dBm\n" "Minimum RSSI:" "$TX_LO"
    echo

    # Depends on the site-specific TX_LO computed above.
    prepare_site_roaming_checks "$site"
    # Site-wide fallback: only fall back to the old per-radio RF-tuning path
    # (assisted_roaming_*) when no WLAN on this site exposed the new
    # roaming_assistant_na_* field at all -- an older controller/API. Checked
    # via the presence flag, NOT whether roaming_wlan.tsv has rows: a
    # 2.4-GHz-only site can have the new field on every WLAN and still
    # produce zero rows (band not applicable), which is not a fallback case.
    # Mixing both models within one site would compare incompatible aggregations.
    roaming_use_wlan_level=false
    [[ -f "$(roaming_field_present_flag_path "$site")" ]] && roaming_use_wlan_level=true

    prepare_site_tx_checks "$site"

    print_general_checks "$site"

    while IFS=$'\t' read -r current_site ap mac ip model; do
      [[ "$current_site" != "$site" ]] && continue
      mac2g=$(mac_with_offset "$mac" 1)
      mac5g=$(mac_with_offset "$mac" 2)
      peers="$(get_peers "$site" "$ap")"
      scan_prefix=$(ap_scan_prefix "$site" "$ap")
      hw_model=$(get_scan_meta "MODEL_NAME" "${scan_prefix}.raw")
      cac5_state=$(get_scan_meta "DFS_CAC_5G" "${scan_prefix}.raw")
      [[ -n "$hw_model" ]] && model=$hw_model
      [[ "$cac5_state" == "active" ]] && has_active_dfs_cac=true

      # Format: ch24|ht24|tx24|min_tx24|max_tx24|txmode24|min_rssi24|min_rssi_en24|ch5|ht5|tx5|min_tx5|max_tx5|txmode5|min_rssi5|min_rssi_en5|roam_enabled|roam_rssi|ib24|ib5|dfs5
      radio_info=$(get_radio_info "$site" "$ap")
      IFS='|' read -r \
        ch24 cht24 tx24 min_tx24 max_tx24 txmode24 min_rssi24 min_rssi_en24 \
        ch5 cht5 tx5 min_tx5 max_tx5 txmode5 min_rssi5 min_rssi_en5 \
        roam_enabled roam_rssi ib24 ib5 dfs5 <<<"$radio_info"
      has_radio24_api=false
      [[ -n "${ch24}${cht24}${tx24}" ]] && has_radio24_api=true
      has_radio5_api=false
      [[ -n "${ch5}${cht5}${tx5}" ]] && has_radio5_api=true

      if [[ -z "$tx24" || -z "$tx5" ]]; then
        printf '  %s  ! Warning: incomplete radio data from API — recommendations may use defaults%s\n' "$RED" "$RESET"
      fi

      # Conservative defaults used only when the API does not expose a field.
      # They keep the report readable, but the warning above should be treated
      # as a sign that the recommendation may be less trustworthy.
      ch24=${ch24:-6}
      cht24=${cht24:-20}
      tx24=${tx24:-11}
      min_tx24=${min_tx24:-$TX_MIN}
      max_tx24=${max_tx24:-$TX_MAX}
      txmode24=${txmode24:-custom}
      min_rssi24=${min_rssi24:--75}
      min_rssi_en24=${min_rssi_en24:-false}
      ch5=${ch5:-100}
      cht5=${cht5:-80}
      tx5=${tx5:-20}
      min_tx5=${min_tx5:-$TX_MIN}
      max_tx5=${max_tx5:-$TX_MAX}
      txmode5=${txmode5:-custom}
      min_rssi5=${min_rssi5:--79}
      min_rssi_en5=${min_rssi_en5:-false}
      roam_enabled=${roam_enabled:-false}
      roam_rssi=${roam_rssi:-}
      ib24=${ib24:-false}
      ib5=${ib5:-false}

      print_ap_header "$ap" "$mac" "$model"

      # Pre-compute peer scan prefixes once (reused for both band loops)
      _peer_prefixes=()
      for peer in $peers; do
        _peer_prefixes+=("$(ap_scan_prefix "$site" "$peer")")
      done

      analyze_band "2.4" "2g" "$scan_prefix" "$mac2g" "$cht24" "$ch24" "$tx24" \
        "$min_tx24" "$max_tx24" "$txmode24" "$min_rssi24" "$min_rssi_en24" "$ib24" \
        "" "" "false" "$has_radio24_api"

      echo

      include_roaming=true
      [[ "$roaming_use_wlan_level" == "true" ]] && include_roaming=false
      analyze_band "5" "5g" "$scan_prefix" "$mac5g" "$cht5" "$ch5" "$tx5" \
        "$min_tx5" "$max_tx5" "$txmode5" "$min_rssi5" "$min_rssi_en5" "$ib5" \
        "$dfs5" "$cac5_state" "$include_roaming" "$has_radio5_api"

      echo
    done <"$APS_FILE"

    print_group_issues "$site"
  done <"$SITES_FILE"

  print_footer "$has_changes" "$has_active_dfs_cac"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
