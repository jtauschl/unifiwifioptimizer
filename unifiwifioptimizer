# Return the MAC address obtained by adding an integer offset to the given MAC.
mac_with_offset() {
  local mac=$1 offset=$2 hex dec new
  hex=${mac//:/}
  dec=$((16#$hex))
  new=$(((dec + offset) & 0xFFFFFFFFFFFF))
  hex=$(printf '%012x' "$new")
  printf '%s:%s:%s:%s:%s:%s\n' \
    "${hex:0:2}" "${hex:2:2}" "${hex:4:2}" \
    "${hex:6:2}" "${hex:8:2}" "${hex:10:2}"
}

# Print the cached RSSI value for a MAC from an RSSI cache file, or empty on miss.
get_rssi() {
  local mac=$1 file=$2
  # || true: awk exits non-zero when $file doesn't exist (missing cache,
  # e.g. before the first scan or for an unsighted peer). A local var=$(...)
  # assignment propagates that exit code under set -e even with no match
  # printed, so this must be swallowed here rather than at each call site.
  awk -F '\t' -v mac="$mac" '$1 == mac { print $2; exit }' "$file" 2>/dev/null || true
}

# Print the space-separated list of configured neighbor AP names for a site AP.
get_peers() {
  local site=$1 ap=$2
  awk -F '\t' -v site="$site" -v ap="$ap" '$1 == site && $2 == ap { print $3; exit }' "$NEIGHBORS_FILE" | tr ',' ' '
}

# Print the MAC address of the named AP within a site.
get_ap_mac() {
  local site=$1 ap=$2
  awk -F '\t' -v site="$site" -v ap="$ap" '$1 == site && $2 == ap { print $3; exit }' "$APS_FILE"
}

# Return success if two APs at a site are configured as neighbors of each other.
aps_are_peers() {
  local site=$1 ap_a=$2 ap_b=$3 peer
  for peer in $(get_peers "$site" "$ap_a"); do
    [[ "$peer" == "$ap_b" ]] && return 0
  done
  for peer in $(get_peers "$site" "$ap_b"); do
    [[ "$peer" == "$ap_a" ]] && return 0
  done
  return 1
}

# Print the maximal adjacency groups of APs at a site as TSV rows.
list_site_groups() {
  local site=$1
  python3 - "$site" "$NEIGHBORS_FILE" <<'PY'
import sys

site_name, neighbors_path = sys.argv[1:]
groups = []
seen = set()

with open(neighbors_path, "r", encoding="utf-8") as handle:
    for line in handle:
        line = line.rstrip("\n")
        if not line:
            continue
        current_site, ap_name, peers = line.split("\t", 2)
        if current_site != site_name:
            continue
        members = tuple(sorted({ap_name, *[peer for peer in peers.split(",") if peer]}))
        if members not in seen:
            seen.add(members)
            groups.append(members)

maximal = []
for group in groups:
    group_set = set(group)
    if any(group_set < set(other) for other in groups):
        continue
    maximal.append(group)

for group in maximal:
    print(f"{' / '.join(group)}\t{','.join(group)}")
PY
}

