# Print a green/red compliance line for a minimum data rate value.
print_general_check_rate() {
  local label=$1 expected_kbps=$2 current_enabled=$3 current_kbps=$4
  local expected_mbps current_mbps
  expected_mbps=$(rate_mbps "$expected_kbps")
  current_mbps=$(rate_mbps "${current_kbps:-0}")

  if ! is_true "$current_enabled"; then
    flag_change
