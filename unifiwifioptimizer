# Compute the center frequency in MHz for a channel on the given band into _result.
channel_center_freq_mhz() {
  local band_key=$1 channel=$2

  [[ "$channel" =~ ^[0-9]+$ ]] || return 1

  case "$band_key" in
  2g) _result=$((2407 + channel * 5)) ;;
  5g) _result=$((5000 + channel * 5)) ;;
  *) return 1 ;;
  esac
}

# Compute the low and high 5 GHz channel numbers of a bonded width block into _low/_high.
channel_span_5g() {
  local channel=$1 width=$2

  [[ "$channel" =~ ^[0-9]+$ ]] || return 1
  [[ "$width" =~ ^[0-9]+$ ]] || width=20

  case "$width" in
  20)
    _low=$channel
    _high=$channel
    ;;
  40)
    case "$channel" in
    36 | 40)
      _low=36
      _high=40
      ;;
    44 | 48)
      _low=44
      _high=48
      ;;
    52 | 56)
      _low=52
      _high=56
      ;;
    60 | 64)
      _low=60
      _high=64
      ;;
    100 | 104)
      _low=100
      _high=104
      ;;
    108 | 112)
      _low=108
      _high=112
      ;;
    116 | 120)
      _low=116
      _high=120
      ;;
    124 | 128)
      _low=124
      _high=128
      ;;
    132 | 136)
      _low=132
      _high=136
      ;;
    140 | 144)
      _low=140
      _high=144
      ;;
    149 | 153)
      _low=149
      _high=153
      ;;
    157 | 161)
      _low=157
      _high=161
      ;;
    *) return 1 ;;
    esac
    ;;
  80)
    case "$channel" in
    36 | 40 | 44 | 48)
      _low=36
      _high=48
      ;;
    52 | 56 | 60 | 64)
      _low=52
      _high=64
      ;;
    100 | 104 | 108 | 112)
      _low=100
      _high=112
      ;;
    116 | 120 | 124 | 128)
      _low=116
      _high=128
      ;;
    132 | 136 | 140 | 144)
      _low=132
      _high=144
      ;;
    149 | 153 | 157 | 161)
      _low=149
      _high=161
      ;;
    *) return 1 ;;
    esac
    ;;
  160)
    case "$channel" in
    36 | 40 | 44 | 48 | 52 | 56 | 60 | 64)
      _low=36
      _high=64
      ;;
    100 | 104 | 108 | 112 | 116 | 120 | 124 | 128)
      _low=100
      _high=128
      ;;
    *) return 1 ;;
    esac
    ;;
  *)
    return 1
    ;;
  esac
}

# Return success if two channel and width combinations occupy overlapping spectrum.
channels_overlap() {
  local band_key=$1 channel_a=$2 width_a=$3 channel_b=$4 width_b=$5
  local freq_a freq_b half_a half_b low_a high_a low_b high_b

  [[ "$width_a" =~ ^[0-9]+$ ]] || width_a=20
  [[ "$width_b" =~ ^[0-9]+$ ]] || width_b=20

  if [[ "$band_key" == "5g" ]]; then
    channel_span_5g "$channel_a" "$width_a" || return 1
    low_a=$_low
    high_a=$_high
    channel_span_5g "$channel_b" "$width_b" || return 1
    low_b=$_low
    high_b=$_high
    ((high_a >= low_b && high_b >= low_a))
    return
  fi

  channel_center_freq_mhz "$band_key" "$channel_a" || return 1
  freq_a=$_result
  channel_center_freq_mhz "$band_key" "$channel_b" || return 1
  freq_b=$_result

  case "$band_key" in
  2g)
    half_a=$((width_a / 2 + 2))
    half_b=$((width_b / 2 + 2))
    ;;
  *)
    half_a=$((width_a / 2))
    half_b=$((width_b / 2))
    ;;
  esac

  low_a=$((freq_a - half_a))
  high_a=$((freq_a + half_a))
  low_b=$((freq_b - half_b))
  high_b=$((freq_b + half_b))

  ((high_a > low_b && high_b > low_a))
}

# Clamp a TX power value into the given min/max range and write it to _result.
cap_tx_power() {
  local tx=$1 min_tx=${2:-$TX_MIN} max_tx=${3:-$TX_MAX}
  ((tx < min_tx)) && tx=$min_tx
  ((tx > max_tx)) && tx=$max_tx
  _result=$tx
}

# ============================================================================
# TX Power Calculation (ALGORITHM.md §5)
# ============================================================================
# Writes SIGNED shift value to _result:
#   positive = increase TX power needed
#   negative = decrease TX power needed
#
# Target: bring the average RSSI @ Neighbor to the center of the TX corridor.
# The derived TX shift uses ceiling rounding, so half steps prefer the next
# higher whole-dBm recommendation instead of rounding down.
# The caller applies cap_tx_power() afterwards.

# Compute the signed TX-power shift needed to center RSSI in the TX corridor into _result.
calculate_tx_shift() {
  local sum_rssi=$1 count_rssi=$2
  local numerator
  local corridor_center=$((TX_LO + CORRIDOR_WIDTH / 2))
  numerator=$((corridor_center * count_rssi - sum_rssi))
  if ((numerator >= 0)); then
    _result=$(((numerator + count_rssi - 1) / count_rssi))
  else
    _result=$((numerator / count_rssi))
  fi
}

# ============================================================================
# TX Power Recommendation (ALGORITHM.md §4/§5)
# ============================================================================
# Combines calculate_tx_shift() + hysteresis + the missing-peer nudge into a
# single reusable recommendation, shared by analyze_band() (per-AP report)
# and prepare_site_tx_checks() (site-wide pending-change precompute).
#
# Args: current_tx, min_tx, max_tx, sum_rssi, count_nbr, peer_count, has_missing_peer_partial
#   peer_count: number of configured peers for this band (regardless of sighting).
#   has_missing_peer_partial: true when count_nbr > 0 but at least one configured
#     peer was NOT sighted (the pre-existing +1 dBm nudge case). Not used when
#     count_nbr == 0 -- that case is handled entirely by the branch below and
#     must not additionally run the nudge (it would push rec_tx past max_tx a
#     second time).
# Writes:
#   _result           recommended TX power (capped)
#   _tx_uncapped      pre-cap value, consumed by the caller's per-neighbor
#                     lo_unfixable/hi projection (ALGORITHM.md §4, coverage warnings)
#   _tx_zero_sightings true when this AP has zero sighted neighbors despite having
#                     at least one configured peer (drives the "No neighbor data"
#                     TX-maximum recommendation instead of silence)
calculate_tx_recommendation() {
  local current_tx=$1 min_tx=$2 max_tx=$3 sum_rssi=$4 count_nbr=$5 peer_count=$6 has_missing_peer_partial=$7
  local shift _delta

  if ((count_nbr == 0)); then
    _tx_zero_sightings=false
    _result=$current_tx
    _tx_uncapped=$current_tx
    if ((peer_count > 0)); then
      # No sighting at all despite configured peers: there is no RF
      # measurement to base a cautious, corridor-based adjustment on, so the
      # usual asymmetric hysteresis does not apply here -- jump straight to
      # the radio maximum to maximize the chance of a sighting on the next
      # scan. Deliberately more aggressive than the corridor logic; see
      # ALGORITHM.md for the rationale and its documented trade-off against
      # vendor TX-spread guidance.
      _result=$max_tx
      _tx_uncapped=$max_tx
      _tx_zero_sightings=true
    fi
    return
  fi

  calculate_tx_shift "$sum_rssi" "$count_nbr"
  shift=$_result
  _tx_uncapped=$((current_tx + shift))
  if ((shift == 0 || (sum_rssi >= TX_LO * count_nbr && sum_rssi <= TX_HI * count_nbr))); then
    _result=$current_tx
  else
    cap_tx_power "$_tx_uncapped" "$min_tx" "$max_tx"
    # cap_tx_power() already wrote the capped value into _result.

    _delta=$((_result - current_tx))
    if ((_delta > 0)); then
      if ((_delta < HYSTERESIS_UP_DB && _result != max_tx)); then
        _result=$current_tx
      fi
    elif ((_delta < 0)); then
      if ((-_delta < HYSTERESIS_DOWN_DB)); then
        _result=$current_tx
      fi
    fi
  fi

  if [[ "$has_missing_peer_partial" == "true" ]]; then
    if ((_result <= current_tx)); then
      cap_tx_power $((current_tx + 1)) "$min_tx" "$max_tx"
      # cap_tx_power() already wrote the capped value into _result.
      _tx_uncapped=$_result
    fi
  fi

  _tx_zero_sightings=false
}

# ============================================================================
# Minimum RSSI Calculation (ALGORITHM.md §6)
# ============================================================================
# Minimum RSSI recommendation sits MIN_RSSI_OFFSET_DB below TX_LO. TX_LO is the
# BTM (soft-roam) trigger for a data client fleet at this environment; a hard
# disconnect at exactly that value leaves no roaming window and creates
# disconnect loops on 802.11v-capable clients. Vendor consensus is 5-8 dB below.

# Write the recommended Minimum RSSI value into _result.
calculate_min_rssi_recommendation() {
  _result=$((TX_LO - MIN_RSSI_OFFSET_DB))
}

# Per-AP Roaming Assistant threshold.
# Default = TX_LO + ROAM_OFFSET_DB (site-aware via path-loss exponent).
# Cap = min(neighbor) - ROAM_MARGIN_DB, but only when min(neighbor) < TX_LO,
# i.e. only when the weakest neighbor is below the target corridor. APs
# whose worst neighbor is still inside the corridor keep the default; the
# cap is not allowed to punish well-placed APs based on noise-level rounding.
# Result is clamped to [ROAM_FLOOR, ROAM_CEILING].
# Args: $1 = min observed neighbor RSSI (empty if no peers seen).
# Writes:
#   _result        recommended threshold in dBm
#   _roam_warn     "" | "capped_by_margin" | "capped_by_floor"
#                  - capped_by_margin: min(nbr)-margin pulled the threshold
#                    below the default and is still above ROAM_FLOOR
#                  - capped_by_floor:  min(nbr)-margin would go below
#                    ROAM_FLOOR and was clamped to it
#   _roam_raw_cap  the uncapped min(nbr)-margin value (for output context),
#                  empty when no cap was applied
calculate_roaming_recommendation() {
  local min_nbr=${1:-}
  local default_thr=$((TX_LO + ROAM_OFFSET_DB))
  local capped=$default_thr
  _roam_warn=""
  _roam_raw_cap=""

  if [[ -n "$min_nbr" ]] && ((min_nbr < TX_LO)); then
    local nbr_cap=$((min_nbr - ROAM_MARGIN_DB))
    if ((nbr_cap < capped)); then
      capped=$nbr_cap
      _roam_raw_cap=$nbr_cap
      if ((nbr_cap < ROAM_FLOOR)); then
        _roam_warn="capped_by_floor"
      else
        _roam_warn="capped_by_margin"
      fi
    fi
  fi

  ((capped < ROAM_FLOOR)) && capped=$ROAM_FLOOR
  ((capped > ROAM_CEILING)) && capped=$ROAM_CEILING
  _result=$capped
}

