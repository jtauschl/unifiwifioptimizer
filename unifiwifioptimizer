#!/usr/bin/env bash

#
# UniFi WiFi Optimizer
#
# Determines TX Power and Roaming Assistant recommendations, plus
# Minimum RSSI guidance, based on neighbor RSSI measurements
# from neighbor APs.
#
# Algorithm: See docs/ALGORITHM.md
# Config:    See config.yaml and profiles.yaml
#
# Usage:
#   ./unifiwifioptimizer
#   ./unifiwifioptimizer --sites
#   ./unifiwifioptimizer --site <siteid>
#   ./unifiwifioptimizer --config <siteid>
#

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_FILE="${SCRIPT_DIR}/config.yaml"
PROFILES_FILE="${SCRIPT_DIR}/profiles.yaml"
WLAN_FIELD_SEP=$'\037'

# Default optimizer parameters
#
# Design basis (Cisco VoWLAN guidelines):
#   CELL_EDGE      = -67 dBm   minimum RSSI at cell edge for voice
#   CELL_OVERLAP   =  20 %     cell area overlap between neighbor APs
#
# Derived constants:
#   ROAM_TARGET    = -67 dBm   VoWLAN cell-edge anchor for the path-loss model
#                              (the per-AP Roaming Assistant threshold is computed
#                              separately, see ALGORITHM.md §7)
#   OVERLAP_DIST   =  60 %     distance ratio corresponding to ~20% area overlap
#   CORRIDOR_WIDTH =   6 dB    symmetric tolerance around corridor center
#
# TX corridor derivation (per site, using path loss exponent n):
#     ΔdB   = 10 · n · log10(100 / OVERLAP_DIST)
#     TX_LO = ROAM_TARGET − ΔdB
#     TX_HI = TX_LO + CORRIDOR_WIDTH
#
#   n is site-specific, set via config.yaml (sites.<site>.environment).
ROAM_TARGET=-67  # VoWLAN cell-edge anchor for the path-loss model (NOT the per-AP threshold)
OVERLAP_DIST=60  # overlap point as % of AP-to-AP distance (~20% area overlap)
CORRIDOR_WIDTH=6 # corridor width in dB

# Roaming Assistant per-AP recommendation (see ALGORITHM.md §7).
# Default = TX_LO + ROAM_OFFSET_DB. Capped against weakest neighbor only when
# that neighbor is below TX_LO (weakest-neighbor-below-corridor), then clamped to [FLOOR, CEILING].
# FLOOR/CEILING match published BTM triggers: Apple iOS/iPad -70 dBm, macOS -75 dBm
# (support.apple.com/guide/deployment/dep98f116c0f). A floor below -75 lets BTM fire
# after macOS clients have already fallen; a ceiling above -65 approaches voice-only
# territory that is aggressive for a data client fleet.
# To reproduce the legacy fixed -67 dBm behavior for VoWLAN sites, set
# ROAM_CEILING=-67 ROAM_OFFSET_DB=<value> where the offset lifts TX_LO to -67
# for the site's environment (Obstructed: +9, Office: +7, Residential: +6, Open: +5).
ROAM_OFFSET_DB=${ROAM_OFFSET_DB:-0}
ROAM_MARGIN_DB=${ROAM_MARGIN_DB:-5}
ROAM_FLOOR=${ROAM_FLOOR:--75}
ROAM_CEILING=${ROAM_CEILING:--65}
# Minimum RSSI (hard disconnect) sits below the BTM (soft-roam) trigger so a
# client has a window to actually roam before being kicked. Vendor consensus is
# 5-8 dB below; setting it equal to the BTM trigger produces disconnect loops
# on modern clients that already honor 802.11v.
MIN_RSSI_OFFSET_DB=${MIN_RSSI_OFFSET_DB:-5}
#
# Path loss exponent n: set environment per site in config.yaml (default: Residential)
# Values are derived from ITU-R P.1238 Table 2, using n where ITU expresses
# the same coefficient as N = 10*n.
#   Preset        n     ΔdB    TX_LO   ITU-R P.1238 category
#   Open          2.2   4.88   −72     Commercial (large open spaces, retail)
#   Residential   2.8   6.21   −73     Residential (default)
#   Office        3.0   6.65   −74     Office
#   Obstructed    4.0   8.87   −76     Obstructed (concrete, brick, multi-wall)
#   <number>      x     —      —       Custom value (e.g. 3.5 → TX_LO ≈ −75)
#
# Conservative fallback limits if the controller does not expose per-radio
# TX min/max values. Small TX changes are suppressed by asymmetric hysteresis:
# prefer slight extra TX over creating a coverage gap.
TX_MIN=6
TX_MAX=23
HYSTERESIS_UP_DB=1
HYSTERESIS_DOWN_DB=3
SCAN_ATTEMPTS=2

# Validate the user-overridable Roaming Assistant tunables. These are read from
# the environment, used in arithmetic expansions, and now documented as knobs;
# a typo such as ROAM_OFFSET_DB=foo would otherwise cause an opaque arithmetic
# error mid-run. Failing here keeps the error message close to the cause.
validate_roam_constants() {
  local var
  for var in ROAM_OFFSET_DB ROAM_MARGIN_DB ROAM_FLOOR ROAM_CEILING MIN_RSSI_OFFSET_DB; do
    if ! [[ "${!var}" =~ ^-?[0-9]+$ ]]; then
      printf 'ERROR: %s must be an integer (got: %s)\n' "$var" "${!var}" >&2
      exit 1
    fi
  done
  # Offset/margin in dB. Upper bound 30 dB is generous; values beyond that
  # would shift the threshold across the entire useful RSSI range.
  if ((ROAM_OFFSET_DB < 0 || ROAM_OFFSET_DB > 30)); then
    printf 'ERROR: ROAM_OFFSET_DB must be in 0..30 dB (got: %d)\n' "$ROAM_OFFSET_DB" >&2
    exit 1
  fi
  if ((ROAM_MARGIN_DB < 0 || ROAM_MARGIN_DB > 30)); then
    printf 'ERROR: ROAM_MARGIN_DB must be in 0..30 dB (got: %d)\n' "$ROAM_MARGIN_DB" >&2
    exit 1
  fi
  # MIN_RSSI_OFFSET_DB: how far below the BTM trigger the hard-disconnect sits.
  # 0 would collapse Min-RSSI onto the BTM trigger (no roaming window); 30 dB
  # would push Min-RSSI into noise-floor territory.
  if ((MIN_RSSI_OFFSET_DB < 0 || MIN_RSSI_OFFSET_DB > 30)); then
    printf 'ERROR: MIN_RSSI_OFFSET_DB must be in 0..30 dB (got: %d)\n' "$MIN_RSSI_OFFSET_DB" >&2
    exit 1
  fi
  # Floor/ceiling are RSSI dBm values used as bounds for the Roaming Assistant
  # threshold. Range -95..-50 dBm: -95 is around the typical noise floor;
  # -50 is the upper edge of plausible roaming-trigger territory. Above -50
  # the threshold would fire while clients are still right next to an AP,
  # which makes Roaming Assistant unusable.
  for var in ROAM_FLOOR ROAM_CEILING; do
    if ((${!var} < -95 || ${!var} > -50)); then
      printf 'ERROR: %s must be in -95..-50 dBm (got: %d)\n' "$var" "${!var}" >&2
      exit 1
    fi
  done
  if ((ROAM_FLOOR >= ROAM_CEILING)); then
    printf 'ERROR: ROAM_FLOOR (%d) must be lower than ROAM_CEILING (%d)\n' \
      "$ROAM_FLOOR" "$ROAM_CEILING" >&2
    exit 1
  fi
}

RED=$'\e[31m'
YELLOW=$'\e[33m'
GREEN=$'\e[32m'
CYAN=$'\e[36m'
RESET=$'\e[0m'
GENERAL_LABEL_WIDTH=32
REC_LABEL_WIDTH=24

