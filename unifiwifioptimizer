            '|'.join(wlan.get('ap_group_ids', []) or []),
            wlan.get('no2ghz_oui', ''),
        ]
        print(sep.join(str(field).replace(sep, ' ') for field in fields))
except Exception:
    sys.exit(1)
PY
  then
    print_api_unavailable_note
    return 1
  fi
}

# Fetch a site's management settings (default SSH user, etc.) into its cache path.
fetch_site_mgmt_settings() {
