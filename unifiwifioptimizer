# Parse a raw scan output and write a MAC-to-best-RSSI cache TSV file.
build_rssi_cache_file() {
  local source_file=$1 cache_file=$2
  python3 - "$source_file" "$cache_file" <<'PY'
import re
import sys

source_file, cache_file = sys.argv[1:]
with open(source_file, "r", encoding="utf-8", errors="ignore") as handle:
    text = handle.read().split("===META===", 1)[0]

mac_re = re.compile(r"^[0-9a-f]{2}(?::[0-9a-f]{2}){5}$")

def write_rows(rows):
    with open(cache_file, "w", encoding="utf-8") as handle:
        for mac, rssi in sorted(rows.items()):
            handle.write(f"{mac}\t{rssi}\n")

best = {}
current_mac = ""
for line in text.splitlines():
    fields = line.split()
    if len(fields) >= 2 and fields[0] == "BSS":
        current_mac = fields[1].split("(", 1)[0].lower()
        continue
    if len(fields) >= 2 and fields[0] == "signal:" and current_mac:
        try:
            rssi = int(float(fields[1]))
        except ValueError:
            current_mac = ""
            continue
        if mac_re.match(current_mac) and -100 < rssi < 0:
            if current_mac not in best or rssi > best[current_mac]:
                best[current_mac] = rssi
        current_mac = ""

write_rows(best)
PY
}

# Parse a raw scan output and write both RSSI and per-MAC channel cache files.
build_rssi_cache_file_with_channels() {
  local source_file=$1 rssi_cache_file=$2 chan_cache_file=$3
  python3 - "$source_file" "$rssi_cache_file" "$chan_cache_file" <<'PY'
import re
import sys

source_file, rssi_cache_file, chan_cache_file = sys.argv[1:]
with open(source_file, "r", encoding="utf-8", errors="ignore") as handle:
    text = handle.read().split("===META===", 1)[0]

mac_re = re.compile(r"^[0-9a-f]{2}(?::[0-9a-f]{2}){5}$")

best = {}
channels = {}
current_mac = ""
current_freq = ""
for line in text.splitlines():
    fields = line.split()
    if len(fields) >= 2 and fields[0] == "BSS":
        current_mac = fields[1].split("(", 1)[0].lower()
        current_freq = ""
        continue
    if len(fields) >= 2 and fields[0] == "freq:" and current_mac:
        current_freq = fields[1]
        continue
    if len(fields) >= 2 and fields[0] == "signal:" and current_mac:
        try:
            rssi = int(float(fields[1]))
        except ValueError:
            current_mac = ""
            current_freq = ""
            continue
        if mac_re.match(current_mac) and -100 < rssi < 0:
            if current_mac not in best or rssi > best[current_mac]:
                best[current_mac] = rssi
                channels[current_mac] = current_freq
        current_mac = ""
        current_freq = ""

with open(rssi_cache_file, "w", encoding="utf-8") as handle:
    for mac, rssi in sorted(best.items()):
        handle.write(f"{mac}\t{rssi}\n")

with open(chan_cache_file, "w", encoding="utf-8") as handle:
    for mac, freq in sorted(channels.items()):
        handle.write(f"{mac}\t{freq}\n")
PY
}

# Aggregate per-pass RSSI caches for a band into a single trimmed-mean cache.
aggregate_rssi_passes() {
  local scan_prefix=$1 band_key=$2 passes=$3
  python3 - "$scan_prefix" "$band_key" "$passes" <<'PY'
import sys
from collections import defaultdict, Counter

scan_prefix, band_key, passes_str = sys.argv[1:]
passes = int(passes_str)

# Collect per-mac: list of (rssi, freq) from each pass
data = defaultdict(list)

for p in range(1, passes + 1):
    rssi_file = f"{scan_prefix}.{band_key}.{p}.rssi"
    chan_file  = f"{scan_prefix}.{band_key}.{p}.chan"

    freqs = {}
    try:
        with open(chan_file, encoding="utf-8") as fh:
            for line in fh:
                parts = line.rstrip("\n").split("\t")
                if len(parts) == 2:
                    freqs[parts[0]] = parts[1]
    except FileNotFoundError:
        pass

    try:
        with open(rssi_file, encoding="utf-8") as fh:
            for line in fh:
                parts = line.rstrip("\n").split("\t")
                if len(parts) == 2:
                    mac = parts[0]
                    try:
                        rssi = int(parts[1])
                    except ValueError:
                        continue
                    data[mac].append((rssi, freqs.get(mac, "")))
    except FileNotFoundError:
        pass

result = {}
for mac, measurements in data.items():
    # Determine consensus frequency (most common non-empty value)
    freqs_seen = [f for _, f in measurements if f]
    if freqs_seen:
        consensus_freq, consensus_count = Counter(freqs_seen).most_common(1)[0]
        # Only use consensus-frequency group if it has a strict majority (> 50%).
        # At a tie, measurements are from different channels and incomparable — skip.
        if consensus_count * 2 > len(measurements):
            vals = [r for r, f in measurements if f == consensus_freq]
        else:
            vals = []
    else:
        vals = [r for r, _ in measurements]

    n = len(vals)
    if n == 0:
        continue
    elif n >= 3:
        vals_sorted = sorted(vals)
        trimmed = vals_sorted[1:-1]
        result[mac] = round(sum(trimmed) / len(trimmed))
    else:
        result[mac] = max(vals)

cache_file = f"{scan_prefix}.{band_key}.rssi"
with open(cache_file, "w", encoding="utf-8") as fh:
    for mac, rssi in sorted(result.items()):
        fh.write(f"{mac}\t{rssi}\n")
PY
}

