}

# Resolves AP group membership for Roaming Assistant WLAN-broadcast filtering
# (ALGORITHM.md §7). The legacy /rest/apgroup endpoint returns
# api.err.InvalidObject for this API-key auth flow; /v2/api/site/.../apgroups
# is the endpoint that actually works (verified against a live controller).
# Each group's device_macs list covers ap_group_mode "all", "group", and
# "specific" uniformly -- UniFi models a WLAN's specific-AP selection as an
# (unnamed, non-hidden) group too, so no special-casing is needed here.
fetch_site_apgroups() {
  local site=$1
  local raw_file

  raw_file="${tmpdir}/$(sanitize_token "$site").apgroups.json"

  # Unlike the other fetch_* helpers, a failure here must NOT abort the run:
  # this v2 endpoint is only relevant to the new WLAN-level Roaming
  # Assistant path, and older controllers (the exact case the site-wide
  # fallback in prepare_site_roaming_checks() exists for) may not have it at
  # all. Under set -e, an unguarded call would kill the whole script before
  # the fallback decision ever gets made.
  if ! fetch_api_json "/proxy/network/v2/api/site/${site}/apgroups" "$raw_file"; then
    : >"$(site_apgroups_tsv_path "$site")"
    return 0
  fi

  if ! python3 - "$raw_file" <<'PY' >"$(site_apgroups_tsv_path "$site")" 2>/dev/null
import sys, json

apgroups_path = sys.argv[1]

try:
    with open(apgroups_path, 'r', encoding='utf-8') as handle:
        groups = json.load(handle)
    sep = '\x1f'
    for group in groups:
        fields = [
            group.get('_id', ''),
            '|'.join(group.get('device_macs', []) or []),
        ]
        print(sep.join(str(field).replace(sep, ' ') for field in fields))
except Exception:
    sys.exit(1)
PY
  then
    # Same tolerance as the curl failure above: a malformed/unexpected
    # response (schema drift, non-JSON body, etc.) must not abort the run
    # either -- treated the same as "endpoint not available".
    print_api_unavailable_note
    : >"$(site_apgroups_tsv_path "$site")"
    return 0
  fi
}

