    printf "  ${RED}  ✗ %-${GENERAL_LABEL_WIDTH}s %s Mbps${RESET}\n" \
      "$label" "$expected_mbps"
    print_ui_path_hint "$label"
  fi
  print_min_rate_dsss_advisory "$label" "${current_kbps:-0}" "$current_enabled"
}

# Advisory: a 2.4 GHz minimum below 12 Mbps still allows 802.11b clients to
# associate and keeps 802.11b protection overhead active for every OFDM frame
# on the SSID. Silent for 5 GHz (has no 802.11b rates) and for disabled
# minimum-rate mode with a zero current value (nothing meaningful to compare).
# 802.11b DSSS rates are 1/2/5.5/11 Mbps specifically; 6 and 9 Mbps are
# 802.11a/g OFDM rates that are still below the 12 Mbps recommendation but
# don't themselves admit 802.11b clients, so the wording differs.
print_min_rate_dsss_advisory() {
  local label=$1 current_kbps=$2 current_enabled=$3
  [[ "$label" != *"2.4 GHz"* ]] && return 0
  [[ -z "$current_kbps" || "$current_kbps" == "0" ]] && return 0
  is_true "$current_enabled" || return 0
  case "$current_kbps" in
  1000 | 2000 | 5500 | 11000)
    printf "  ${YELLOW}    ! %s is an 802.11b DSSS rate — kills 802.11b support and cuts broadcast airtime by raising to 12000 kbps (12 Mbps, lowest OFDM rate).${RESET}\n" \
      "$(rate_mbps "$current_kbps") Mbps"
    return 0
    ;;
  esac

  if ((current_kbps < 12000)); then
    printf "  ${YELLOW}    ! %s is below the 12 Mbps recommendation — raising to 12000 kbps cuts broadcast airtime, though this rate doesn't itself admit 802.11b clients.${RESET}\n" \
      "$(rate_mbps "$current_kbps") Mbps"
  fi
}

